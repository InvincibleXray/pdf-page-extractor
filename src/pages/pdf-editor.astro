---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EditorUploadState from '../components/editor/EditorUploadState.astro';
import EditorHeader from '../components/editor/EditorHeader.astro';
import EditorToolbar from '../components/editor/EditorToolbar.astro';
import EditorThumbnails from '../components/editor/EditorThumbnails.astro';
import EditorViewport from '../components/editor/EditorViewport.astro';
import EditorInspector from '../components/editor/EditorInspector.astro';
import EditorBottomBar from '../components/editor/EditorBottomBar.astro';
import EditorMobileSheets from '../components/editor/EditorMobileSheets.astro';
---

<Layout
  title="PDF Editor Online — Edit PDF In-Browser, No Upload"
  description="Add text, edit existing text, annotate, highlight, and redact PDF documents directly in your browser. No server uploads, no signup required."
  canonicalUrl="https://pdfpage.tools/pdf-editor/"
>
  <!-- STATE 1: Landing / Upload State -->
  <div id="editor-landing-view" class="w-full flex-1 flex flex-col justify-between">
    <Header activeTool="editor" />
    <main class="w-full max-w-7xl mx-auto px-4 sm:px-8 flex-1 flex flex-col justify-center">
      <EditorUploadState />
    </main>
  </div>

  <!-- STATE 2: Active Editor Workspace -->
  <div id="editor-workspace-view" class="hidden fixed inset-0 flex flex-col bg-[#f8fafc] dark:bg-[#0c1017] z-50 overflow-hidden">
    <!-- Top Header -->
    <EditorHeader />

    <!-- Floating Export Toast / Progress Indicator -->
    <div
      id="editor-export-toast"
      class="fixed top-16 right-6 z-50 transform transition-all duration-300 translate-y-[-20px] opacity-0 pointer-events-none flex items-center gap-3 px-4 py-3 rounded-2xl bg-white dark:bg-[#1a2232] border border-slate-200 dark:border-slate-700 shadow-xl shadow-slate-900/10 dark:shadow-black/50 text-slate-900 dark:text-white"
      role="status"
      aria-live="polite"
    >
      <div id="export-toast-spinner" class="w-4 h-4 border-2 border-brand-500 border-t-transparent rounded-full animate-spin"></div>
      <svg id="export-toast-check" class="w-4 h-4 text-emerald-500 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12" />
      </svg>
      <div class="flex flex-col">
        <span id="export-toast-title" class="text-xs font-bold leading-tight">Exporting PDF...</span>
        <span id="export-toast-desc" class="text-[11px] text-slate-500 dark:text-slate-400 leading-tight">Preparing document bytes</span>
      </div>
    </div>

    <!-- Functional Tool Bar -->
    <EditorToolbar />

    <!-- Dynamic XFA Notification Banner -->
    <div
      id="editor-xfa-banner"
      class="hidden w-full bg-amber-50 dark:bg-amber-950/60 border-b border-amber-200 dark:border-amber-800/60 px-4 py-2 flex items-center justify-between text-xs text-amber-800 dark:text-amber-200 z-20"
      role="alert"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>
          <strong>Notice:</strong> This PDF contains dynamic Adobe XFA forms. Interactive form editing is not supported in browser-based editors. You can view, annotate, and manage pages, but dynamic form fields cannot be edited.
        </span>
      </div>
      <button
        type="button"
        id="dismiss-xfa-banner-btn"
        class="p-1 rounded text-amber-600 hover:text-amber-900 dark:text-amber-400 dark:hover:text-white"
        title="Dismiss notice"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Main Workspace 3-Column Layout -->
    <div class="flex-1 flex overflow-hidden relative">
      <!-- Left Sidebar: Pages & Thumbnails (Desktop) -->
      <div id="desktop-thumbnails-wrapper" class="hidden md:flex h-full">
        <EditorThumbnails />
      </div>

      <!-- Center: Viewport & Canvas -->
      <main class="flex-1 relative flex flex-col h-full overflow-hidden">
        <EditorViewport />
        <!-- Floating Bottom Controls -->
        <EditorBottomBar />
      </main>

      <!-- Right Sidebar: Contextual Inspector (Desktop) -->
      <div id="desktop-inspector-wrapper" class="hidden md:flex h-full">
        <EditorInspector />
      </div>
    </div>

    <!-- Mobile Drawers & Bottom Sheets -->
    <EditorMobileSheets />
  </div>
  
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "PDFPage.Tools PDF Editor",
    "url": "https://pdfpage.tools/pdf-editor/",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires a modern web browser with JavaScript enabled",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Add text, edit existing text, annotate, highlight, and redact PDF documents directly in your browser. No server uploads required."
  }
  </script>
</Layout>

<script>
  import {
    editorStore,
    type EditorObject,
    type TextEditorObject,
    type TextReplacementEditorObject,
    type ShapeEditorObject,
    type AnnotationEditorObject,
    type PrivacyEditorObject,
    type RedactionEditorObject,
    type PenEditorObject,
    type ImageEditorObject,
    type EditorTool,
    type PageState,
  } from '../utils/editorState';
  import { loadPdfDocumentManager, type LoadedPdfDoc } from '../utils/pdfDocumentManager';
  import { pdfRenderer } from '../utils/pdfRenderer';
  import { interactionController } from '../utils/editorInteractionController';
  import { pdfRectToScreenRect } from '../utils/coordinateMapper';
  import { exportPdfDocument, type FormExportMode } from '../utils/pdfExportEngine';
  import { pdfTextLayerManager } from '../utils/pdfTextLayer';
  import { PDFDocument, rgb, StandardFonts } from 'pdf-lib';
  import type { PageViewport } from 'pdfjs-dist';
  import { formStore } from '../utils/formState';
  import { pdfFormOverlayManager } from '../utils/pdfFormOverlay';

  // Helper to detect dynamic XFA in pristine PDF bytes
  function detectXfaInBytes(bytes: ArrayBuffer): boolean {
    const uint8 = new Uint8Array(bytes);
    const len = Math.min(uint8.length, 500000);
    for (let i = 0; i < len - 4; i++) {
      if (uint8[i] === 0x2f && uint8[i + 1] === 0x58 && uint8[i + 2] === 0x46 && uint8[i + 3] === 0x41) {
        return true;
      }
    }
    return false;
  }

  // DOM Elements - State 1
  const landingView = document.getElementById('editor-landing-view');
  const workspaceView = document.getElementById('editor-workspace-view');
  const fileInput = document.getElementById('editor-file-input') as HTMLInputElement | null;
  const dropZone = document.getElementById('editor-drop-zone');

  // DOM Elements - State 2 Header & Tools
  const backBtn = document.getElementById('editor-back-btn');
  const newDocBtn = document.getElementById('editor-new-doc-btn');
  const exportBtn = document.getElementById('editor-export-btn');
  const docNameLabel = document.getElementById('editor-doc-name');
  const docSizeLabel = document.getElementById('editor-doc-size');
  const themeToggleBtn = document.getElementById('editor-theme-toggle-btn');
  const themeKnob = document.getElementById('editor-theme-knob');

  // Dynamic XFA Notification Banner
  const editorXfaBanner = document.getElementById('editor-xfa-banner');
  const dismissXfaBannerBtn = document.getElementById('dismiss-xfa-banner-btn');

  // Export Toast Elements
  const exportToast = document.getElementById('editor-export-toast');
  const exportToastSpinner = document.getElementById('export-toast-spinner');
  const exportToastCheck = document.getElementById('export-toast-check');
  const exportToastTitle = document.getElementById('export-toast-title');
  const exportToastDesc = document.getElementById('export-toast-desc');

  // Tool buttons
  const toolButtons = document.querySelectorAll<HTMLButtonElement>('.editor-tool-btn');
  const rotatePageBtn = document.getElementById('tool-rotate-page-btn');
  const moreToolsBtn = document.getElementById('tool-more-btn');
  const moreToolsMenu = document.getElementById('tool-more-menu');
  const undoBtn = document.getElementById('tool-undo-btn') as HTMLButtonElement | null;
  const redoBtn = document.getElementById('tool-redo-btn') as HTMLButtonElement | null;

  // Viewport & Layers
  const viewport = document.getElementById('editor-viewport');
  const scaleContainer = document.getElementById('viewport-scale-container');
  const pdfCard = document.getElementById('pdf-page-card');
  const pdfCanvas = document.getElementById('pdf-canvas') as HTMLCanvasElement | null;
  const overlayLayer = document.getElementById('editor-overlay-layer');
  const selectionBox = document.getElementById('selection-bounding-box');
  const pdfTextLayer = document.getElementById('pdf-text-layer');
  const pdfFormLayer = document.getElementById('pdf-form-layer');
  const existingTextActionBar = document.getElementById('existing-text-action-bar');

  // Sidebars & Toggles
  const desktopThumbnailsWrapper = document.getElementById('desktop-thumbnails-wrapper');
  const desktopInspectorWrapper = document.getElementById('desktop-inspector-wrapper');
  const toggleThumbnailsBtn = document.getElementById('toggle-thumbnails-btn');
  const toggleInspectorBtn = document.getElementById('toggle-inspector-btn');
  const closeInspectorBtn = document.getElementById('close-inspector-btn');
  const thumbnailsContainer = document.getElementById('thumbnails-container');
  const thumbnailPageCount = document.getElementById('thumbnail-page-count');

  // Thumbnail Context Menu Elements
  const thumbnailContextMenu = document.getElementById('thumbnail-context-menu');
  const ctxRotateBtn = document.getElementById('ctx-rotate-btn');
  const ctxDuplicateBtn = document.getElementById('ctx-duplicate-btn');
  const ctxMoveUpBtn = document.getElementById('ctx-move-up-btn');
  const ctxMoveDownBtn = document.getElementById('ctx-move-down-btn');
  const ctxDeleteBtn = document.getElementById('ctx-delete-btn');

  // Bottom Controls
  const zoomOutBtn = document.getElementById('zoom-out-btn');
  const zoomInBtn = document.getElementById('zoom-in-btn');
  const zoomPercentBtn = document.getElementById('zoom-percent-btn');
  const zoomPercentText = document.getElementById('zoom-percent-text');
  const zoomFitPageBtn = document.getElementById('zoom-fit-page-btn');
  const zoomFitWidthBtn = document.getElementById('zoom-fit-width-btn');
  const pagePrevBtn = document.getElementById('page-prev-btn') as HTMLButtonElement | null;
  const pageNextBtn = document.getElementById('page-next-btn') as HTMLButtonElement | null;
  const bottomCurrentPage = document.getElementById('bottom-current-page');
  const bottomTotalPages = document.getElementById('bottom-total-pages');
  const fullscreenBtn = document.getElementById('fullscreen-toggle-btn');

  // Inspector Elements
  const inspectorTitle = document.getElementById('inspector-title');
  const inspectorBadge = document.getElementById('inspector-badge');
  const paneDocument = document.getElementById('pane-document');
  const paneText = document.getElementById('pane-text');
  const paneShape = document.getElementById('pane-shape');
  const paneComment = document.getElementById('pane-comment');
  const paneRedact = document.getElementById('pane-redact');

  // Redact Pane Props
  const redactColorBlack = document.getElementById('redact-color-black');
  const redactColorWhite = document.getElementById('redact-color-white');
  const redactPropOverlayText = document.getElementById('redact-prop-overlay-text') as HTMLInputElement | null;
  const deleteRedactBtn = document.getElementById('delete-redact-btn');

  // Redaction Modal Props
  const redactModal = document.getElementById('redaction-confirm-modal');
  const redactModalCount = document.getElementById('redact-modal-count');
  const redactStripMetaCheck = document.getElementById('redact-strip-metadata-checkbox') as HTMLInputElement | null;
  const closeRedactModalBtn = document.getElementById('close-redact-modal-btn');
  const cancelRedactExportBtn = document.getElementById('cancel-redact-export-btn');
  const confirmRedactExportBtn = document.getElementById('confirm-redact-export-btn');

  // Form Export Mode Modal Elements (Phase 6C)
  const formExportModeModal = document.getElementById('form-export-mode-modal');
  const exportModeInteractiveBtn = document.getElementById('export-mode-interactive-btn');
  const exportModeFlattenedBtn = document.getElementById('export-mode-flattened-btn');
  const closeExportModeModalBtn = document.getElementById('close-export-mode-modal-btn');
  const cancelExportModeBtn = document.getElementById('cancel-export-mode-btn');
  const exportXfaWarning = document.getElementById('export-xfa-warning');
  const exportSignatureWarning = document.getElementById('export-signature-warning');
  const exportRedactionNotice = document.getElementById('export-redaction-notice');
  let selectedFormExportMode: FormExportMode = 'interactive';

  // Document Pane Props
  const docPropCurrentPage = document.getElementById('doc-prop-current-page');
  const docPropDimensions = document.getElementById('doc-prop-dimensions');
  const docPropOrientation = document.getElementById('doc-prop-orientation');
  const docPropRotation = document.getElementById('doc-prop-rotation');
  const docPropZoom = document.getElementById('doc-prop-zoom');
  const docPropFilename = document.getElementById('doc-prop-filename');
  const docPropFilesize = document.getElementById('doc-prop-filesize');

  // Text Pane Props
  const textFontFamily = document.getElementById('text-font-family') as HTMLSelectElement | null;
  const textFontSize = document.getElementById('text-font-size') as HTMLInputElement | null;
  const textBoldBtn = document.getElementById('text-bold-btn');
  const textItalicBtn = document.getElementById('text-italic-btn');
  const textUnderlineBtn = document.getElementById('text-underline-btn');
  const textOpacitySlider = document.getElementById('text-opacity-slider') as HTMLInputElement | null;
  const textOpacityVal = document.getElementById('text-opacity-val');
  const textCustomColor = document.getElementById('text-custom-color') as HTMLInputElement | null;
  const deleteTextBtn = document.getElementById('delete-text-btn');

  // Shape Pane Props
  const shapeStrokeWidth = document.getElementById('shape-stroke-width') as HTMLInputElement | null;
  const shapeStrokeVal = document.getElementById('shape-stroke-val');
  const shapeRadiusSlider = document.getElementById('shape-radius-slider') as HTMLInputElement | null;
  const shapeRadiusVal = document.getElementById('shape-radius-val');
  const deleteShapeBtn = document.getElementById('delete-shape-btn');

  // Comment Pane Props
  const commentPropText = document.getElementById('comment-prop-text') as HTMLTextAreaElement | null;
  const commentPropAuthor = document.getElementById('comment-prop-author');
  const commentPropTime = document.getElementById('comment-prop-time');
  const deleteCommentBtn = document.getElementById('delete-comment-btn');

  // Form Field Pane Props
  const paneFormField = document.getElementById('pane-form-field');
  const formPropNameInput = document.getElementById('form-prop-name-input') as HTMLInputElement | null;
  const formPropName = document.getElementById('form-prop-name');
  const formPropNameError = document.getElementById('form-prop-name-error');
  const formPropType = document.getElementById('form-prop-type');
  const formPropRequiredBadge = document.getElementById('form-prop-required-badge');
  const formPropReadonlyBadge = document.getElementById('form-prop-readonly-badge');
  const formPropTooltipInput = document.getElementById('form-prop-tooltip-input') as HTMLInputElement | null;
  const formPropDefaultValueInput = document.getElementById('form-prop-default-value-input') as HTMLInputElement | null;
  const formPropExportValGroup = document.getElementById('form-prop-export-val-group');
  const formPropExportValInput = document.getElementById('form-prop-export-val-input') as HTMLInputElement | null;
  const formPropRequiredChk = document.getElementById('form-prop-required-chk') as HTMLInputElement | null;
  const formPropReadonlyChk = document.getElementById('form-prop-readonly-chk') as HTMLInputElement | null;
  const formPropMultilineGroup = document.getElementById('form-prop-multiline-group');
  const formPropMultilineChk = document.getElementById('form-prop-multiline-chk') as HTMLInputElement | null;
  const formPropMaxlengthGroup = document.getElementById('form-prop-maxlength-group');
  const formPropMaxlengthInput = document.getElementById('form-prop-maxlength-input') as HTMLInputElement | null;
  const formPropFontsizeInput = document.getElementById('form-prop-fontsize-input') as HTMLInputElement | null;
  const formPropOptionsGroup = document.getElementById('form-prop-options-group');
  const formPropOptionsList = document.getElementById('form-prop-options-list');
  const formPropNewOptionInput = document.getElementById('form-prop-new-option-input') as HTMLInputElement | null;
  const formPropAddOptionBtn = document.getElementById('form-prop-add-option-btn');
  const formPropDuplicateBtn = document.getElementById('form-prop-duplicate-btn');
  const formPropResetBtn = document.getElementById('form-prop-reset-btn');
  const formPropDeleteBtn = document.getElementById('form-prop-delete-btn');
  const formPropTabList = document.getElementById('form-prop-tab-list');

  // Toolbar Form Controls
  const toolFormDropdownBtn = document.getElementById('tool-form-dropdown-btn');
  const toolFormMenu = document.getElementById('tool-form-menu');
  const toggleAuthorModeBtn = document.getElementById('toggle-author-mode-btn');
  const authorModeThumb = document.getElementById('author-mode-thumb');

  // Mobile Sheets
  const mobileBackdrop = document.getElementById('mobile-sheet-backdrop');
  const mobileDrawer = document.getElementById('mobile-thumbnails-drawer');
  const mobileSheet = document.getElementById('mobile-inspector-sheet');
  const closeMobileDrawerBtn = document.getElementById('close-mobile-drawer-btn');
  const closeMobileSheetBtn = document.getElementById('close-mobile-sheet-btn');
  const mobileOpenPagesBtn = document.getElementById('mobile-open-pages-btn');
  const mobileOpenInspectorBtn = document.getElementById('mobile-open-inspector-btn');
  const mobileThumbnailsList = document.getElementById('mobile-thumbnails-list');
  const mobileInspectorContent = document.getElementById('mobile-inspector-content');
  const mobileThumbnailBadge = document.getElementById('mobile-thumbnail-badge');

  // Signature & Image Elements
  const sigModal = document.getElementById('signature-modal');
  const closeSigModalBtn = document.getElementById('close-sig-modal-btn');
  const clearSigBtn = document.getElementById('clear-sig-btn');
  const saveSigBtn = document.getElementById('save-sig-btn');
  const sigCanvas = document.getElementById('sig-pad-canvas') as HTMLCanvasElement | null;
  const sigHint = document.getElementById('sig-pad-hint');
  const imageFileInput = document.getElementById('editor-image-file-input') as HTMLInputElement | null;

  // Active Session State
  let loadedDoc: LoadedPdfDoc | null = null;
  let currentRenderViewport: PageViewport | null = null;
  let lastRenderedPage = -1;
  let lastRenderedZoom = -1;
  let lastRenderedRotation = -1;
  let lastRenderedSourceIdx = -1;
  let isPageRendering = false;
  let renderQueued = false;
  let lastPagesKey = '';
  let activeContextMenuPageNum = -1;

  if (typeof window !== 'undefined') {
    (window as any).__PDF_LOADED_DOC__ = () => loadedDoc;
    (window as any).__PDF_EDITOR_STORE__ = editorStore;
    (window as any).__PDF_FORM_STORE__ = formStore;
    (window as any).__PDF_FORM_OVERLAY__ = pdfFormOverlayManager;
    (window as any).__PDF_INTERACTION_CONTROLLER__ = interactionController;
  }

  // --- EXPORT TOAST NOTIFICATIONS ---
  const showExportToast = (title: string, desc: string, isFinished = false, isError = false) => {
    if (!exportToast) return;
    exportToast.classList.remove('hidden', 'opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
    exportToast.classList.add('opacity-100', 'translate-y-0');

    if (exportToastTitle) exportToastTitle.textContent = title;
    if (exportToastDesc) exportToastDesc.textContent = desc;

    if (isFinished) {
      if (exportToastSpinner) exportToastSpinner.classList.add('hidden');
      if (exportToastCheck) exportToastCheck.classList.remove('hidden');
      if (isError) {
        if (exportToastTitle) exportToastTitle.classList.add('text-rose-600');
      }
      setTimeout(() => {
        exportToast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
        setTimeout(() => {
          if (exportToastSpinner) exportToastSpinner.classList.remove('hidden');
          if (exportToastCheck) exportToastCheck.classList.add('hidden');
          if (exportToastTitle) exportToastTitle.classList.remove('text-rose-600');
        }, 300);
      }, 3500);
    } else {
      if (exportToastSpinner) exportToastSpinner.classList.remove('hidden');
      if (exportToastCheck) exportToastCheck.classList.add('hidden');
    }
  };

  // --- TRANSITIONS & FILE HANDLING ---
  const showWorkspace = () => {
    if (landingView) landingView.classList.add('hidden');
    if (workspaceView) workspaceView.classList.remove('hidden');

    if (overlayLayer && pdfCanvas) {
      interactionController.attach(overlayLayer, pdfCanvas, pdfTextLayer, existingTextActionBar, pdfFormLayer, selectionBox);
    }
    if (pdfFormLayer) {
      pdfFormOverlayManager.attach(pdfFormLayer);
    }

    // Auto-fit page width on mobile screens
    if (window.innerWidth < 768) {
      const mobileZoom = Math.min(1.0, Math.max(0.40, (window.innerWidth - 24) / 595));
      editorStore.setZoom(mobileZoom);
    }
    syncThemeUI();
  };

  window.addEventListener('resize', () => {
    if (window.innerWidth < 768 && editorStore.getState().document) {
      const mobileZoom = Math.min(1.0, Math.max(0.40, (window.innerWidth - 24) / 595));
      editorStore.setZoom(mobileZoom);
    }
  });

  const showLanding = () => {
    interactionController.detach();
    pdfRenderer.cancelCurrentRender();
    pdfTextLayerManager.clear(pdfTextLayer);
    pdfFormOverlayManager.clear();
    pdfFormOverlayManager.detach();
    formStore.reset();
    if (editorXfaBanner) editorXfaBanner.classList.add('hidden');
    if (loadedDoc) {
      loadedDoc.destroy();
      loadedDoc = null;
    }
    currentRenderViewport = null;
    lastRenderedPage = -1;
    lastRenderedZoom = -1;
    isPageRendering = false;
    renderQueued = false;
    editorStore.reset();
    if (workspaceView) workspaceView.classList.add('hidden');
    if (landingView) landingView.classList.remove('hidden');
  };


  const handleSelectedFile = async (file: File) => {
    try {
      if (loadedDoc) {
        loadedDoc.destroy();
        loadedDoc = null;
      }
      const doc = await loadPdfDocumentManager(file);
      loadedDoc = doc;
      if (typeof window !== 'undefined') {
        (window as any).__PDF_LOADED_DOC__ = () => loadedDoc;
        (window as any).__PDF_EDITOR_STORE__ = editorStore;
        (window as any).__PDF_FORM_STORE__ = formStore;
        (window as any).__PDF_FORM_OVERLAY__ = pdfFormOverlayManager;
      }

      // Check AcroForm & dynamic XFA status
      let hasAcroForm = false;
      try {
        const fieldObjects = await doc.docProxy.getFieldObjects();
        hasAcroForm = fieldObjects !== null && Object.keys(fieldObjects).length > 0;
      } catch (e) {
        // Ignored
      }
      let isXfa = detectXfaInBytes(doc.pristineBytes);
      try {
        const meta = await doc.docProxy.getMetadata();
        if ((meta?.info as any)?.IsXFAPresent) {
          isXfa = true;
        }
      } catch (e) {
        // Ignored
      }
      formStore.initDocument(hasAcroForm, isXfa);
      if (editorXfaBanner) {
        if (isXfa) {
          editorXfaBanner.classList.remove('hidden');
        } else {
          editorXfaBanner.classList.add('hidden');
        }
      }

      const sampleLimit = Math.min(doc.pageCount, 20);
      const dimensions = [];
      for (let i = 1; i <= sampleLimit; i++) {
        dimensions.push(await doc.getPageDimensions(i));
      }
      const defaultDim = dimensions[0] || { width: 595, height: 842 };
      for (let i = sampleLimit + 1; i <= doc.pageCount; i++) {
        dimensions.push(defaultDim);
      }

      editorStore.loadDocument(file, doc.pageCount, dimensions);
      showWorkspace();
      await triggerPageRender();
      renderThumbnails(doc, 1);
    } catch (err: any) {
      alert(err.message || 'Failed to load PDF document.');
    }
  };

  // Dropzone Events
  if (dropZone && fileInput) {
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        handleSelectedFile(fileInput.files[0]);
      }
    });

    ['dragenter', 'dragover'].forEach((eventName) => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.add('drag-active');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-active');
      });
    });

    dropZone.addEventListener('drop', (e: DragEvent) => {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleSelectedFile(e.dataTransfer.files[0]);
      }
    });
  }

  // Navigation & Reset Buttons
  if (newDocBtn) newDocBtn.addEventListener('click', showLanding);
  if (backBtn) {
    backBtn.addEventListener('click', (e) => {
      if (editorStore.getState().document) {
        e.preventDefault();
        showLanding();
      }
    });
  }

  // Export Handlers (Real pdf-lib client-side export with form support and redaction synthesis)
  const executeExport = async (options?: { sanitizeMetadata?: boolean; exportMode?: FormExportMode }) => {
    const state = editorStore.getState();
    if (!loadedDoc) {
      alert('Please open or load a PDF document first.');
      return;
    }

    // Pre-flight XFA check (FAIL-CLOSED)
    if (formStore.isXfa()) {
      showExportToast('Export Blocked', 'XFA forms are not supported.', true, true);
      alert('XFA forms are not supported.');
      return;
    }

    const mode = options?.exportMode || selectedFormExportMode || 'interactive';
    const isForm = formStore.hasForm() || formStore.getFields().length > 0;
    const toastTitle = isForm && mode === 'flattened' ? 'Exporting Flattened PDF...' : 'Exporting PDF...';
    showExportToast(toastTitle, 'Applying annotations and preparing bytes', false);

    const result = await exportPdfDocument(
      loadedDoc.pristineBytes,
      state.objects,
      state.document?.name || 'document.pdf',
      (stage) => {
        if (exportToastDesc) exportToastDesc.textContent = stage;
      },
      state.document?.pages,
      {
        sanitizeMetadata: options?.sanitizeMetadata !== undefined ? options.sanitizeMetadata : true,
        loadedDocProxy: loadedDoc.docProxy,
        exportMode: mode,
      }
    );

    if (result.success) {
      showExportToast('Export Complete!', `Downloaded ${result.filename}`, true);
    } else {
      showExportToast('Export Failed', result.error || 'Failed to export PDF', true, true);
    }
  };

  const handleExportClick = () => {
    const state = editorStore.getState();
    if (!loadedDoc) {
      alert('Please open or load a PDF document first.');
      return;
    }

    // 1. HARD XFA FAIL-CLOSED GATE
    if (formStore.isXfa()) {
      showExportToast('Export Blocked', 'XFA forms are not supported.', true, true);
      return;
    }

    const hasForm = formStore.hasForm() || formStore.getFields().length > 0;
    const redactions = state.objects.filter((o) => o.type === 'redact');
    const hasSignatures = formStore.getFields().some((f) => f.type === 'signature');

    if (hasForm && formExportModeModal) {
      if (exportSignatureWarning) {
        if (hasSignatures) exportSignatureWarning.classList.remove('hidden');
        else exportSignatureWarning.classList.add('hidden');
      }
      if (exportRedactionNotice) {
        if (redactions.length > 0) exportRedactionNotice.classList.remove('hidden');
        else exportRedactionNotice.classList.add('hidden');
      }
      formExportModeModal.classList.remove('hidden');
      return;
    }

    if (redactions.length > 0) {
      if (redactModalCount) {
        redactModalCount.textContent = `${redactions.length} redaction region${redactions.length > 1 ? 's' : ''}`;
      }
      redactModal?.classList.remove('hidden');
      return;
    }

    executeExport();
  };

