  if (closeSigModalBtn && sigModal) {
    closeSigModalBtn.addEventListener('click', () => sigModal.classList.add('hidden'));
  }

  let isSigDrawing = false;
  let sigCtx: CanvasRenderingContext2D | null = null;
  if (sigCanvas) {
    sigCtx = sigCanvas.getContext('2d');
    if (sigCtx) {
      sigCtx.strokeStyle = '#0f172a';
      sigCtx.lineWidth = 2.5;
      sigCtx.lineCap = 'round';
      sigCtx.lineJoin = 'round';
    }

    const getSigPos = (e: MouseEvent | TouchEvent) => {
      const rect = sigCanvas.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      return {
        x: (clientX - rect.left) * (sigCanvas.width / rect.width),
        y: (clientY - rect.top) * (sigCanvas.height / rect.height),
      };
    };

    const startSig = (e: MouseEvent | TouchEvent) => {
      if (!sigCtx) return;
      isSigDrawing = true;
      if (sigHint) sigHint.classList.add('hidden');
      const pos = getSigPos(e);
      sigCtx.beginPath();
      sigCtx.moveTo(pos.x, pos.y);
    };

    const moveSig = (e: MouseEvent | TouchEvent) => {
      if (!isSigDrawing || !sigCtx) return;
      e.preventDefault();
      const pos = getSigPos(e);
      sigCtx.lineTo(pos.x, pos.y);
      sigCtx.stroke();
    };

    const stopSig = () => {
      isSigDrawing = false;
    };

    sigCanvas.addEventListener('mousedown', startSig);
    sigCanvas.addEventListener('mousemove', moveSig);
    window.addEventListener('mouseup', stopSig);
    sigCanvas.addEventListener('touchstart', startSig);
    sigCanvas.addEventListener('touchmove', moveSig);
    window.addEventListener('touchend', stopSig);
  }

  if (clearSigBtn && sigCanvas && sigCtx) {
    clearSigBtn.addEventListener('click', () => {
      sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
      if (sigHint) sigHint.classList.remove('hidden');
    });
  }

  if (saveSigBtn && sigCanvas && sigModal) {
    saveSigBtn.addEventListener('click', () => {
      const dataUrl = sigCanvas.toDataURL('image/png');
      const sigObj: ImageEditorObject = {
        id: `sig-${Date.now()}`,
        type: 'image',
        pageNumber: editorStore.getState().currentPage,
        x: 100,
        y: 100,
        width: 150,
        height: 60,
        rotation: 0,
        opacity: 1,
        zIndex: 15,
        src: dataUrl,
        originalWidth: 400,
        originalHeight: 160,
        keepRatio: true,
      };
      editorStore.addObject(sigObj, true);
      sigModal.classList.add('hidden');
      editorStore.setActiveTool('select');
    });
  }

  // --- RENDER & STATE SYNCHRONIZATION ---
  let draggedThumbIndex: number | null = null;

  const renderThumbnails = async (doc: LoadedPdfDoc, currentPage: number) => {
    const state = editorStore.getState();
    const pages = state.document?.pages || [];
    const totalPages = pages.length;
    const maxVisibleThumbs = Math.min(totalPages, 50);

    const createThumbnailHTML = (p: PageState, pNum: number, isCurrent: boolean) => `
      <div
        data-page="${pNum}"
        data-page-index="${pNum - 1}"
        data-page-id="${p.id}"
        draggable="true"
        class="thumbnail-card group relative cursor-pointer flex flex-col items-center select-none"
      >
        <div
          class="w-36 h-48 rounded-xl bg-white dark:bg-[#1a2232] border-2 transition-all p-1 flex flex-col justify-between overflow-hidden shadow-xs relative ${
            isCurrent
              ? 'border-brand-500 ring-2 ring-brand-500/20 shadow-md'
              : 'border-slate-200 dark:border-[#212b3c] hover:border-slate-300 dark:hover:border-slate-600'
          }"
        >
          <canvas class="thumb-canvas w-full h-full object-contain block bg-white" data-thumb-page="${pNum}" data-source-page="${p.sourcePageIndex + 1}" data-rotation="${p.rotation}"></canvas>
          ${
            p.rotation !== 0
              ? `<span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-brand-500 text-white shadow-xs">${p.rotation}°</span>`
              : ''
          }
        </div>
        <div class="flex items-center justify-between w-36 mt-1.5 px-1">
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold ${isCurrent ? 'text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-400'}">${pNum}</span>
            <span class="text-[10px] text-slate-400">Page ${p.originalPageNumber}</span>
          </div>
          <button
            type="button"
            data-page-menu-trigger="${pNum}"
            class="p-1 rounded text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            title="Page Options"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="1" />
              <circle cx="12" cy="5" r="1" />
              <circle cx="12" cy="19" r="1" />
            </svg>
          </button>
        </div>
      </div>
    `;

    let html = '';
    for (let i = 0; i < maxVisibleThumbs; i++) {
      const p = pages[i];
      html += createThumbnailHTML(p, i + 1, i + 1 === currentPage);
    }
    if (totalPages > maxVisibleThumbs) {
      html += `
        <div class="text-center py-2 text-[11px] text-slate-400 dark:text-slate-500 font-medium bg-slate-50 dark:bg-[#161c28] rounded-xl border border-dashed border-slate-200 dark:border-slate-800 p-2">
          + ${totalPages - maxVisibleThumbs} more pages
        </div>
      `;
    }

    if (thumbnailsContainer) {
      thumbnailsContainer.innerHTML = html;
      thumbnailsContainer.querySelectorAll<HTMLElement>('.thumbnail-card').forEach((el) => {
        const pNum = Number(el.getAttribute('data-page'));
        const pIdx = Number(el.getAttribute('data-page-index'));

        el.addEventListener('click', (e) => {
          const menuBtn = (e.target as HTMLElement).closest('[data-page-menu-trigger]');
          if (menuBtn) {
            e.stopPropagation();
            const rect = menuBtn.getBoundingClientRect();
            showContextMenu(rect.right, rect.bottom, pNum);
            return;
          }
          if (pNum) editorStore.setCurrentPage(pNum);
        });

        // HTML5 Drag and drop
        el.addEventListener('dragstart', (e) => {
          draggedThumbIndex = pIdx;
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', String(pIdx));
          }
          el.classList.add('opacity-50');
        });

        el.addEventListener('dragend', () => {
          el.classList.remove('opacity-50');
          draggedThumbIndex = null;
        });

        el.addEventListener('dragover', (e) => {
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
          el.classList.add('ring-2', 'ring-brand-400');
        });

        el.addEventListener('dragleave', () => {
          el.classList.remove('ring-2', 'ring-brand-400');
        });

        el.addEventListener('drop', (e) => {
          e.preventDefault();
          el.classList.remove('ring-2', 'ring-brand-400');
          if (draggedThumbIndex !== null && draggedThumbIndex !== pIdx) {
            editorStore.reorderPages(draggedThumbIndex, pIdx);
          }
        });
      });
    }

    if (mobileThumbnailsList) {
      let mobileHtml = '';
      for (let i = 0; i < maxVisibleThumbs; i++) {
        const p = pages[i];
        const pNum = i + 1;
        const isCurrent = pNum === currentPage;
        mobileHtml += `
          <div
            data-page="${pNum}"
            class="mobile-thumbnail-card p-3 rounded-2xl bg-slate-50 dark:bg-[#161c28] border ${
              isCurrent ? 'border-brand-500 ring-2 ring-brand-500/20' : 'border-slate-200 dark:border-[#212836]'
            } flex items-center justify-between gap-3"
          >
            <div class="flex items-center gap-3 cursor-pointer flex-1 select-none" data-mobile-page-select="${pNum}">
              <div class="w-16 h-20 rounded-lg bg-white dark:bg-[#1a2232] border border-slate-200 dark:border-slate-700 overflow-hidden relative flex-shrink-0">
                <canvas class="thumb-canvas w-full h-full object-contain block bg-white" data-thumb-page="${pNum}" data-source-page="${p.sourcePageIndex + 1}" data-rotation="${p.rotation}"></canvas>
                ${p.rotation !== 0 ? `<span class="absolute top-0.5 left-0.5 px-1 rounded text-[8px] font-bold bg-brand-500 text-white">${p.rotation}°</span>` : ''}
              </div>
              <div>
                <span class="text-xs font-bold text-slate-900 dark:text-white">Page ${pNum}</span>
                <p class="text-[10px] text-slate-400">Original #${p.originalPageNumber}${p.rotation ? ` · ${p.rotation}°` : ''}</p>
              </div>
            </div>
            <div class="flex items-center gap-1">
              <button
                type="button"
                data-mobile-move-up="${pNum}"
                ${pNum === 1 ? 'disabled' : ''}
                class="p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 disabled:opacity-30 disabled:pointer-events-none transition-colors"
                title="Move Up"
                aria-label="Move page up"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
              </button>
              <button
                type="button"
                data-mobile-move-down="${pNum}"
                ${pNum === totalPages ? 'disabled' : ''}
                class="p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 disabled:opacity-30 disabled:pointer-events-none transition-colors"
                title="Move Down"
                aria-label="Move page down"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <button
                type="button"
                data-mobile-rotate="${pNum}"
                class="p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
                title="Rotate 90°"
                aria-label="Rotate page 90 degrees"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8"/><path d="M21 3v5h-5"/></svg>
              </button>
              <button
                type="button"
                data-mobile-delete="${pNum}"
                class="p-2 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors"
                title="Delete Page"
                aria-label="Delete page"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
              </button>
            </div>
          </div>
        `;
      }
      mobileThumbnailsList.innerHTML = mobileHtml;

      mobileThumbnailsList.querySelectorAll<HTMLElement>('[data-mobile-page-select]').forEach((el) => {
        el.addEventListener('click', () => {
          const p = Number(el.getAttribute('data-mobile-page-select'));
          if (p) {
            editorStore.setCurrentPage(p);
            closeMobileDrawer();
          }
        });
      });
      mobileThumbnailsList.querySelectorAll<HTMLElement>('[data-mobile-move-up]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const p = Number(el.getAttribute('data-mobile-move-up'));
          if (p) editorStore.movePageUp(p);
        });
      });
      mobileThumbnailsList.querySelectorAll<HTMLElement>('[data-mobile-move-down]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const p = Number(el.getAttribute('data-mobile-move-down'));
          if (p) editorStore.movePageDown(p);
        });
      });
      mobileThumbnailsList.querySelectorAll<HTMLElement>('[data-mobile-rotate]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const p = Number(el.getAttribute('data-mobile-rotate'));
          if (p) editorStore.rotatePage(p);
        });
      });
      mobileThumbnailsList.querySelectorAll<HTMLElement>('[data-mobile-delete]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const p = Number(el.getAttribute('data-mobile-delete'));
          if (p) {
            if (totalPages <= 1) {
              if (!confirm('This is the only page in the document. Deleting it will leave the document empty. Continue?')) {
                return;
              }
            }
            editorStore.deletePage(p);
          }
        });
      });
    }

    // Asynchronously render thumbnail canvas bitmaps for visible thumbnails
    for (let i = 0; i < maxVisibleThumbs; i++) {
      const p = pages[i];
      const pNum = i + 1;
      const canvases = document.querySelectorAll<HTMLCanvasElement>(`canvas[data-thumb-page="${pNum}"]`);
      if (canvases.length > 0) {
        try {
          const page = await doc.docProxy.getPage(p.sourcePageIndex + 1);
          const viewport = page.getViewport({ scale: 0.25, rotation: p.rotation });
          canvases.forEach((c) => {
            c.width = viewport.width;
            c.height = viewport.height;
            const ctx = c.getContext('2d');
            if (ctx) {
              page.render({ canvasContext: ctx, viewport });
            }
          });
        } catch (e) {
          // Thumbnail render non-critical
        }
      }
    }
  };

  const renderOverlayObjects = (
    objects: EditorObject[],
    selectedId: string | null,
    viewport: PageViewport | null
  ) => {
    if (!overlayLayer) return;
    overlayLayer.innerHTML = '';

    if (pdfTextLayer) {
      const hiddenSpans = pdfTextLayer.querySelectorAll<HTMLElement>('span[style*="visibility: hidden"]');
      hiddenSpans.forEach((s) => (s.style.visibility = 'visible'));
    }

    objects.forEach((obj) => {
      const isSelected = obj.id === selectedId;
      const el = document.createElement('div');
      el.id = `obj-${obj.id}`;
      el.setAttribute('data-object-id', obj.id);
      el.className = `absolute cursor-pointer transition-shadow select-none pointer-events-auto touch-none ${
        isSelected ? 'ring-2 ring-brand-500' : 'hover:ring-1 hover:ring-brand-300'
      }`;
      el.style.touchAction = 'none';

      if (viewport) {
        const screenRect = pdfRectToScreenRect(obj, viewport);
        el.style.left = `${screenRect.left}px`;
        el.style.top = `${screenRect.top}px`;
        el.style.width = `${screenRect.width}px`;
        el.style.height = `${screenRect.height}px`;
      } else {
        el.style.left = `${obj.x}px`;
        el.style.top = `${obj.y}px`;
        el.style.width = `${obj.width}px`;
        el.style.height = `${obj.height}px`;
      }

      el.style.opacity = `${obj.opacity}`;
      el.style.zIndex = `${obj.zIndex}`;

      if (obj.type === 'text') {
        const textObj = obj as TextEditorObject;
        el.style.fontFamily = textObj.fontFamily;
        const fontSize = viewport ? textObj.fontSize * viewport.scale : textObj.fontSize;
        el.style.fontSize = `${fontSize}px`;
        el.style.fontWeight = textObj.fontWeight;
        el.style.fontStyle = textObj.fontStyle;
        el.style.textDecoration = textObj.textDecoration;
        el.style.textAlign = textObj.textAlign;
        el.style.color = textObj.color;
        el.style.padding = '2px 4px';
        el.style.lineHeight = '1.3';
        el.style.whiteSpace = 'pre-wrap';
        el.style.wordBreak = 'break-word';
        el.textContent = textObj.text;
      } else if (obj.type === 'text-replacement') {
        const repObj = obj as TextReplacementEditorObject;
        if (pdfTextLayer && repObj.sourceTextItemId) {
          pdfTextLayerManager.hideSpan(repObj.sourceTextItemId, pdfTextLayer);
        }
        el.style.backgroundColor = repObj.backgroundColor || '#ffffff';
        el.style.fontFamily = repObj.fontFamily;
        const fontSize = viewport ? repObj.fontSize * viewport.scale : repObj.fontSize;
        el.style.fontSize = `${fontSize}px`;
        el.style.fontWeight = repObj.fontWeight;
        el.style.fontStyle = repObj.fontStyle;
        el.style.textDecoration = repObj.textDecoration;
        el.style.textAlign = repObj.textAlign;
        el.style.color = repObj.color;
        el.style.display = 'flex';
        el.style.alignItems = 'center';
        el.style.padding = '0 2px';
        el.style.lineHeight = '1.2';
        el.style.whiteSpace = 'nowrap';
        el.textContent = repObj.replacementText;
      } else if (obj.type === 'highlight') {
        el.style.backgroundColor = (obj as any).color || '#facc15';
        el.style.mixBlendMode = 'multiply';
        el.style.borderRadius = '2px';
      } else if (obj.type === 'underline') {
        const annObj = obj as AnnotationEditorObject;
        el.style.borderBottom = `${annObj.strokeWidth || 2}px solid ${annObj.color || '#2563eb'}`;
      } else if (obj.type === 'strikethrough') {
        const annObj = obj as AnnotationEditorObject;
        el.style.display = 'flex';
        el.style.alignItems = 'center';
        el.innerHTML = `<div style="width: 100%; height: ${annObj.strokeWidth || 2}px; background-color: ${annObj.color || '#dc2626'};"></div>`;
      } else if (obj.type === 'comment') {
        const annObj = obj as AnnotationEditorObject;
        el.style.display = 'flex';
        el.style.alignItems = 'center';
        el.style.justifyContent = 'center';
        el.innerHTML = `
          <div class="w-7 h-7 rounded-full bg-amber-500 text-white shadow-md flex items-center justify-center hover:scale-110 transition-transform cursor-pointer" title="${annObj.commentText || 'Comment'}">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
        `;
      } else if (obj.type === 'redact') {
        const redObj = obj as RedactionEditorObject;
        el.style.backgroundColor = 'rgba(239, 68, 68, 0.25)';
        el.style.border = '2px dashed #dc2626';
        el.style.display = 'flex';
        el.style.alignItems = 'center';
        el.style.justifyContent = 'center';
        if (redObj.overlayText && redObj.overlayText.trim().length > 0) {
          el.innerHTML = `<span class="text-[11px] font-bold text-white bg-black/85 px-1.5 py-0.5 rounded shadow">${redObj.overlayText}</span>`;
        } else {
          el.innerHTML = `<span class="text-[10px] font-bold tracking-wider text-rose-700 bg-white/90 px-1.5 py-0.5 rounded shadow-xs uppercase">REDACTION PREVIEW</span>`;
        }
      } else if (obj.type === 'whiteout') {
        el.style.backgroundColor = '#ffffff';
        el.style.border = '1px solid rgba(226, 232, 240, 0.8)';
      } else if (obj.type === 'rectangle') {
        const shapeObj = obj as ShapeEditorObject;
        el.style.backgroundColor = shapeObj.fillColor;
        el.style.border = `${shapeObj.strokeWidth}px ${shapeObj.strokeStyle} ${shapeObj.strokeColor}`;
        el.style.borderRadius = `${shapeObj.borderRadius || 0}px`;
      } else if (obj.type === 'ellipse') {
        const shapeObj = obj as ShapeEditorObject;
        el.style.backgroundColor = shapeObj.fillColor;
        el.style.border = `${shapeObj.strokeWidth}px ${shapeObj.strokeStyle} ${shapeObj.strokeColor}`;
        el.style.borderRadius = '9999px';
      } else if (obj.type === 'line' || obj.type === 'arrow') {
        const shapeObj = obj as ShapeEditorObject;
        el.innerHTML = `
          <svg class="w-full h-full overflow-visible">
            <line x1="0" y1="0" x2="${el.style.width}" y2="${el.style.height}" stroke="${shapeObj.strokeColor}" stroke-width="${shapeObj.strokeWidth}" />
          </svg>
        `;
      } else if (obj.type === 'pen') {
        const penObj = obj as PenEditorObject;
        let d = penObj.pathData;
        if (!d && (penObj as any).points && Array.isArray((penObj as any).points) && (penObj as any).points.length > 0) {
          const pts = (penObj as any).points;
          d = `M ${pts[0].x} ${pts[0].y}`;
          for (let i = 1; i < pts.length; i++) {
            d += ` L ${pts[i].x} ${pts[i].y}`;
          }
        }
        if (!d || d.includes('undefined') || d.includes('NaN')) {
          d = 'M 0 0';
        }
        el.innerHTML = `
          <svg class="w-full h-full overflow-visible">
            <path d="${d}" stroke="${penObj.strokeColor || '#2563eb'}" stroke-width="${penObj.strokeWidth || 2}" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        `;
      } else if (obj.type === 'image') {
        const imgObj = obj as ImageEditorObject;
        const img = document.createElement('img');
        img.src = imgObj.src;
        img.className = 'w-full h-full object-contain pointer-events-none';
        el.appendChild(img);
      }

      el.addEventListener('click', (e) => {
        e.stopPropagation();
        editorStore.selectObject(obj.id);
      });

      overlayLayer.appendChild(el);
    });

    if (selectionBox) {
      if (selectedId) {
        const selectedObj = objects.find((o) => o.id === selectedId);
        if (selectedObj && viewport) {
          const screenRect = pdfRectToScreenRect(selectedObj, viewport);
          selectionBox.classList.remove('hidden');
          selectionBox.style.left = `${screenRect.left}px`;
          selectionBox.style.top = `${screenRect.top}px`;
          selectionBox.style.width = `${screenRect.width}px`;
          selectionBox.style.height = `${screenRect.height}px`;
          if (selectedObj.type === 'text') {
            interactionController.positionActionBar(screenRect);
          } else {
            interactionController.hideExistingTextActionBar();
          }
        } else {
          selectionBox.classList.add('hidden');
          interactionController.hideExistingTextActionBar();
        }
      } else {
        selectionBox.classList.add('hidden');
        if (!editorStore.getSelectedExistingTextId()) {
          interactionController.hideExistingTextActionBar();
        }
      }
    }
  };

  const populateMobileInspector = () => {
    if (!mobileInspectorContent) return;
    const selected = editorStore.getSelectedObject();
    const activeFormFieldId = formStore.getFocusedFieldId() || formStore.getActiveFieldId();
    if (!selected) {
      if (activeFormFieldId && paneFormField) {
        mobileInspectorContent.innerHTML = paneFormField.innerHTML;
      } else if (paneDocument) {
        mobileInspectorContent.innerHTML = paneDocument.innerHTML;
      }
    } else if (selected.type === 'text' || selected.type === 'text-replacement') {
      if (paneText) mobileInspectorContent.innerHTML = paneText.innerHTML;
    } else if (selected.type === 'rectangle' || selected.type === 'ellipse') {
      if (paneShape) mobileInspectorContent.innerHTML = paneShape.innerHTML;
    } else if (selected.type === 'comment') {
      if (paneComment) mobileInspectorContent.innerHTML = paneComment.innerHTML;
    }
  };

  // Click on empty viewport deselects object
  if (viewport) {
    viewport.addEventListener('click', (e) => {
      if (Date.now() - ((window as any).__PDF_JUST_DRAGGED__ || 0) < 350) return;
      if (e.target === viewport || e.target === scaleContainer || e.target === pdfCard) {
        editorStore.selectObject(null);
        formStore.setFocusedField(null);
        if (paneFormField) paneFormField.classList.add('hidden');
        if (paneDocument) paneDocument.classList.remove('hidden');
        if (inspectorTitle) inspectorTitle.textContent = 'Properties';
        if (inspectorBadge) inspectorBadge.textContent = 'Document';
      }
    });

    let scrollRafId: number | null = null;
    viewport.addEventListener(
      'scroll',
      () => {
        if (scrollRafId !== null) return;
        scrollRafId = requestAnimationFrame(() => {
          scrollRafId = null;
          interactionController.repositionCurrentActionBar();
        });
      },
      { passive: true }
    );
  }

  window.addEventListener('resize', () => {
    interactionController.repositionCurrentActionBar();
  });

  // --- INSPECTOR EVENTS & BINDINGS ---
  if (textFontFamily) {
    textFontFamily.addEventListener('change', () => {
      editorStore.updateSelectedObject({ fontFamily: textFontFamily.value } as Partial<TextEditorObject>);
    });
  }

  if (textFontSize) {
    textFontSize.addEventListener('input', () => {
      editorStore.updateSelectedObject({ fontSize: Number(textFontSize.value) || 14 } as Partial<TextEditorObject>);
    });
  }

  if (textBoldBtn) {
    textBoldBtn.addEventListener('click', () => {
      const selected = editorStore.getSelectedObject() as any;
      if (selected && (selected.type === 'text' || selected.type === 'text-replacement')) {
        const newWeight = selected.fontWeight === 'bold' ? 'normal' : 'bold';
        editorStore.updateSelectedObject({ fontWeight: newWeight });
      }
    });
  }

  if (textItalicBtn) {
    textItalicBtn.addEventListener('click', () => {
      const selected = editorStore.getSelectedObject() as any;
      if (selected && (selected.type === 'text' || selected.type === 'text-replacement')) {
        const newStyle = selected.fontStyle === 'italic' ? 'normal' : 'italic';
        editorStore.updateSelectedObject({ fontStyle: newStyle });
      }
    });
  }

  if (textUnderlineBtn) {
    textUnderlineBtn.addEventListener('click', () => {
      const selected = editorStore.getSelectedObject() as any;
      if (selected && (selected.type === 'text' || selected.type === 'text-replacement')) {
        const newDec = selected.textDecoration === 'underline' ? 'none' : 'underline';
        editorStore.updateSelectedObject({ textDecoration: newDec });
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.text-align-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const align = btn.getAttribute('data-align') as 'left' | 'center' | 'right';
      if (align) {
        editorStore.updateSelectedObject({ textAlign: align });
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-color]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const color = btn.getAttribute('data-color');
      if (color) {
        editorStore.updateSelectedObject({ color });
      }
    });
  });

  if (textCustomColor) {
    textCustomColor.addEventListener('input', () => {
      editorStore.updateSelectedObject({ color: textCustomColor.value });
    });
  }

  if (textOpacitySlider && textOpacityVal) {
    textOpacitySlider.addEventListener('input', () => {
      const opacity = Number(textOpacitySlider.value) / 100;
      textOpacityVal.textContent = `${textOpacitySlider.value}%`;
      editorStore.updateSelectedObject({ opacity });
    });
  }

  if (deleteTextBtn) {
    deleteTextBtn.addEventListener('click', () => editorStore.deleteSelectedObject());
  }

  const inspectorEditTextBtn = document.getElementById('inspector-edit-text-btn');
  if (inspectorEditTextBtn) {
    inspectorEditTextBtn.addEventListener('click', () => {
      const selected = editorStore.getSelectedObject();
      if (selected && (selected.type === 'text' || selected.type === 'text-replacement')) {
        interactionController.openInlineTextEditor(selected);
      }
    });
  }

  if (mobileInspectorContent) {
    mobileInspectorContent.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('#inspector-edit-text-btn');
      if (target) {
        const selected = editorStore.getSelectedObject();
        if (selected && (selected.type === 'text' || selected.type === 'text-replacement')) {
          closeMobileSheet();
          interactionController.openInlineTextEditor(selected);
        }
      }
    });
  }

  // Shape bindings
  document.querySelectorAll<HTMLButtonElement>('[data-shape-fill]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const fill = btn.getAttribute('data-shape-fill');
      if (fill) {
        editorStore.updateSelectedObject({ fillColor: fill } as Partial<ShapeEditorObject>);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-shape-stroke]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const stroke = btn.getAttribute('data-shape-stroke');
      if (stroke) {
        editorStore.updateSelectedObject({ strokeColor: stroke } as Partial<ShapeEditorObject>);
      }
    });
  });

  if (shapeStrokeWidth && shapeStrokeVal) {
    shapeStrokeWidth.addEventListener('input', () => {
      const width = Number(shapeStrokeWidth.value);
      shapeStrokeVal.textContent = `${width} px`;
      editorStore.updateSelectedObject({ strokeWidth: width } as Partial<ShapeEditorObject>);
    });
  }

  if (shapeRadiusSlider && shapeRadiusVal) {
    shapeRadiusSlider.addEventListener('input', () => {
      const r = Number(shapeRadiusSlider.value);
      shapeRadiusVal.textContent = `${r} px`;
      editorStore.updateSelectedObject({ borderRadius: r } as Partial<ShapeEditorObject>);
    });
  }

  if (deleteShapeBtn) {
    deleteShapeBtn.addEventListener('click', () => editorStore.deleteSelectedObject());
  }

  // Comment bindings
  if (commentPropText) {
    commentPropText.addEventListener('input', () => {
      editorStore.updateSelectedObject({ commentText: commentPropText.value } as Partial<AnnotationEditorObject>);
    });
  }

  if (deleteCommentBtn) {
    deleteCommentBtn.addEventListener('click', () => {
      editorStore.deleteSelectedObject();
    });
  }

  // Redact bindings
  if (redactColorBlack) {
    redactColorBlack.addEventListener('click', () => {
      editorStore.updateSelectedObject({ fillColor: '#000000', textColor: '#ffffff' } as Partial<RedactionEditorObject>);
    });
  }

  if (redactColorWhite) {
    redactColorWhite.addEventListener('click', () => {
      editorStore.updateSelectedObject({ fillColor: '#ffffff', textColor: '#000000' } as Partial<RedactionEditorObject>);
    });
  }

  if (redactPropOverlayText) {
    redactPropOverlayText.addEventListener('input', () => {
      editorStore.updateSelectedObject({ overlayText: redactPropOverlayText.value } as Partial<RedactionEditorObject>);
    });
  }

  if (deleteRedactBtn) {
    deleteRedactBtn.addEventListener('click', () => {
      editorStore.deleteSelectedObject();
    });
  }

  // --- TRIGGER PAGE RENDER ---
  const triggerPageRender = async () => {
    if (!loadedDoc || !pdfCanvas) return;
    const state = editorStore.getState();
    const pageNum = state.currentPage;
    const zoom = state.viewport.zoom;
    const pageState = state.document?.pages[pageNum - 1];
    const sourcePageIndex = pageState ? pageState.sourcePageIndex : pageNum - 1;
    const pageRotation = pageState ? pageState.rotation : 0;

    const needsCanvasRender =
      lastRenderedPage !== pageNum ||
      lastRenderedZoom !== zoom ||
      lastRenderedRotation !== pageRotation ||
      lastRenderedSourceIdx !== sourcePageIndex ||
      !currentRenderViewport;

    if (needsCanvasRender) {
      if (isPageRendering) {
        renderQueued = true;
        return;
      }
      isPageRendering = true;
      lastRenderedPage = pageNum;
      lastRenderedZoom = zoom;
      lastRenderedRotation = pageRotation;
      lastRenderedSourceIdx = sourcePageIndex;

      try {
        const viewport = await pdfRenderer.renderPage(pdfCanvas, loadedDoc.docProxy, sourcePageIndex + 1, {
          scale: zoom,
          rotation: pageRotation,
        });
        if (viewport) {
          currentRenderViewport = viewport;
          try {
            (window as any).__PDF_VIEWPORT__ = viewport;
          } catch (e) {}
          interactionController.setViewport(viewport);

          if (pdfCard) {
            pdfCard.style.width = `${Math.floor(viewport.width)}px`;
            pdfCard.style.height = `${Math.floor(viewport.height)}px`;
          }
          if (overlayLayer) {
            overlayLayer.style.width = `${Math.floor(viewport.width)}px`;
            overlayLayer.style.height = `${Math.floor(viewport.height)}px`;
          }
          if (pdfTextLayer) {
            pdfTextLayer.style.width = `${Math.floor(viewport.width)}px`;
            pdfTextLayer.style.height = `${Math.floor(viewport.height)}px`;
            await pdfTextLayerManager.renderTextLayer(pdfTextLayer, loadedDoc.docProxy, sourcePageIndex + 1, viewport);
          }
          if (pdfFormLayer) {
            pdfFormLayer.style.width = `${Math.floor(viewport.width)}px`;
            pdfFormLayer.style.height = `${Math.floor(viewport.height)}px`;
            const pageProxy = await loadedDoc.docProxy.getPage(sourcePageIndex + 1);
            await pdfFormOverlayManager.discoverPageWidgets(pageProxy, pageNum);
            pdfFormOverlayManager.renderFormOverlay(pageNum, viewport);
          }
        }
      } catch (e) {
        console.error('Render error:', e);
      } finally {
        isPageRendering = false;
        if (renderQueued) {
          renderQueued = false;
          triggerPageRender();
        }
      }
    }

    if (currentRenderViewport) {
      const pageObjects = editorStore.getPageObjects(pageNum);
      renderOverlayObjects(pageObjects, state.selectedObjectId, currentRenderViewport);
      pdfFormOverlayManager.syncDomValues();
    }
  };

  const updateFormInspector = (focusedFieldId: string | null) => {
    if (!focusedFieldId) {
      if (paneFormField) paneFormField.classList.add('hidden');
      return;
    }
    const field = formStore.getField(focusedFieldId);
    if (!field) {
      if (paneFormField) paneFormField.classList.add('hidden');
      return;
    }

    if (inspectorTitle) inspectorTitle.textContent = 'Form Field';
    if (inspectorBadge) inspectorBadge.textContent = 'AcroForm';
    if (paneDocument) paneDocument.classList.add('hidden');
    if (paneText) paneText.classList.add('hidden');
    if (paneShape) paneShape.classList.add('hidden');
    if (paneComment) paneComment.classList.add('hidden');
    if (paneRedact) paneRedact.classList.add('hidden');
    if (paneFormField) paneFormField.classList.remove('hidden');

    if (formPropNameInput) {
      formPropNameInput.value = field.name;
    }
    if (formPropName) {
      formPropName.textContent = field.name;
    }
    if (formPropNameError) formPropNameError.classList.add('hidden');
    if (formPropType) formPropType.textContent = field.type;
    if (formPropRequiredBadge) formPropRequiredBadge.classList.toggle('hidden', !field.required);
    if (formPropReadonlyBadge) formPropReadonlyBadge.classList.toggle('hidden', !field.readOnly);

    if (formPropTooltipInput) formPropTooltipInput.value = field.tooltip || '';
    if (formPropDefaultValueInput) {
      formPropDefaultValueInput.value =
        typeof field.defaultValue === 'string'
          ? field.defaultValue
          : field.defaultValue !== undefined
            ? String(field.defaultValue)
            : '';
    }

    if (formPropExportValGroup && formPropExportValInput) {
      if (field.type === 'radio' || field.type === 'checkbox') {
        formPropExportValGroup.classList.remove('hidden');
        formPropExportValInput.value = field.exportValue || '';
      } else {
        formPropExportValGroup.classList.add('hidden');
      }
    }

    if (formPropRequiredChk) formPropRequiredChk.checked = !!field.required;
    if (formPropReadonlyChk) formPropReadonlyChk.checked = !!field.readOnly;

    if (formPropMultilineGroup && formPropMultilineChk) {
      if (field.type === 'text' || field.type === 'multiline') {
        formPropMultilineGroup.classList.remove('hidden');
        formPropMultilineChk.checked = !!field.multiline;
      } else {
        formPropMultilineGroup.classList.add('hidden');
      }
    }

    if (formPropMaxlengthGroup && formPropMaxlengthInput) {
      if (field.type === 'text' || field.type === 'multiline') {
        formPropMaxlengthGroup.classList.remove('hidden');
        formPropMaxlengthInput.value = field.maxLength ? String(field.maxLength) : '';
      } else {
        formPropMaxlengthGroup.classList.add('hidden');
      }
    }

    if (formPropFontsizeInput) formPropFontsizeInput.value = String(field.fontSize || 12);

    // Alignment buttons styling
    document.querySelectorAll<HTMLButtonElement>('.form-align-btn').forEach((btn) => {
      const align = btn.getAttribute('data-form-align');
      if (align === (field.alignment || 'left')) {
        btn.classList.add('bg-white', 'dark:bg-[#1a2232]', 'shadow-xs', 'font-bold', 'text-brand-600');
      } else {
        btn.classList.remove('bg-white', 'dark:bg-[#1a2232]', 'shadow-xs', 'font-bold', 'text-brand-600');
      }
    });

    // Options for choice fields (dropdown / listbox)
    if (formPropOptionsGroup && formPropOptionsList) {
      if (field.type === 'dropdown' || field.type === 'listbox') {
        formPropOptionsGroup.classList.remove('hidden');
        let optionsHtml = '';
        const opts = field.options || [];
        opts.forEach((opt, idx) => {
          optionsHtml += `
            <div class="flex items-center gap-1.5 bg-slate-50 dark:bg-[#101621] p-1.5 rounded-lg border border-slate-200/60 dark:border-[#212836]" data-option-index="${idx}">
              <input type="text" class="form-option-input flex-1 bg-white dark:bg-[#161c28] border border-slate-200 dark:border-[#212836] rounded px-1.5 py-0.5 text-xs text-slate-800 dark:text-slate-200" value="${opt.label}" data-option-idx="${idx}" />
              <button type="button" class="form-option-remove-btn w-6 h-6 flex items-center justify-center rounded text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40" data-remove-idx="${idx}" title="Remove Option">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          `;
        });
        formPropOptionsList.innerHTML = optionsHtml;

        // Bind option edits and removes
        formPropOptionsList.querySelectorAll<HTMLInputElement>('.form-option-input').forEach((input) => {
          input.addEventListener('change', () => {
            const idx = Number(input.getAttribute('data-option-idx'));
            if (!isNaN(idx) && field.options && field.options[idx]) {
              field.options[idx].label = input.value;
              field.options[idx].value = input.value;
              formStore.updateFieldProperties(field.id, { options: [...field.options] });
              if (currentRenderViewport) {
                pdfFormOverlayManager.renderFormOverlay(editorStore.getState().currentPage, currentRenderViewport);
              }
            }
          });
        });

        formPropOptionsList.querySelectorAll<HTMLButtonElement>('.form-option-remove-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const idx = Number(btn.getAttribute('data-remove-idx'));
            if (!isNaN(idx) && field.options) {
              const newOpts = field.options.filter((_, i) => i !== idx);
              formStore.updateFieldProperties(field.id, { options: newOpts });
              updateFormInspector(field.id);
              if (currentRenderViewport) {
                pdfFormOverlayManager.renderFormOverlay(editorStore.getState().currentPage, currentRenderViewport);
              }
            }
          });
        });
      } else {
        formPropOptionsGroup.classList.add('hidden');
      }
    }

    // Render Tab Order List
    if (formPropTabList) {
      const curPage = editorStore.getState().currentPage;
      const tabOrder = formStore.getTabOrder(curPage);
      let tabHtml = '';
      tabOrder.forEach((fId, idx) => {
        const f = formStore.getField(fId);
        const fName = f ? f.name : fId;
        const isCurrent = fId === field.id;
        tabHtml += `
          <div class="flex items-center justify-between px-2 py-1 rounded-lg border ${
            isCurrent
              ? 'bg-brand-50 border-brand-300 dark:bg-brand-950/40 dark:border-brand-800'
              : 'bg-white dark:bg-[#161c28] border-slate-200/60 dark:border-[#212836]'
          }">
            <div class="flex items-center gap-1.5 overflow-hidden">
              <span class="w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-[10px] font-bold flex items-center justify-center">${idx + 1}</span>
              <span class="text-xs truncate max-w-[120px] font-medium ${isCurrent ? 'text-brand-600 dark:text-brand-400' : 'text-slate-700 dark:text-slate-300'}">${fName}</span>
            </div>
            <div class="flex items-center gap-0.5">
              <button type="button" class="tab-order-up-btn p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-30 disabled:pointer-events-none" data-tab-from="${idx}" ${idx === 0 ? 'disabled' : ''} title="Move Up in Tab Order">
                <svg class="w-3 h-3 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
              </button>
              <button type="button" class="tab-order-down-btn p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-30 disabled:pointer-events-none" data-tab-from="${idx}" ${idx === tabOrder.length - 1 ? 'disabled' : ''} title="Move Down in Tab Order">
                <svg class="w-3 h-3 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          </div>
        `;
      });
      formPropTabList.innerHTML = tabHtml;

      formPropTabList.querySelectorAll<HTMLButtonElement>('.tab-order-up-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const from = Number(btn.getAttribute('data-tab-from'));
          if (from > 0) {
            formStore.reorderTabItem(curPage, from, from - 1);
            updateFormInspector(field.id);
            if (currentRenderViewport) {
              pdfFormOverlayManager.renderFormOverlay(curPage, currentRenderViewport);
            }
          }
        });
      });

      formPropTabList.querySelectorAll<HTMLButtonElement>('.tab-order-down-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const from = Number(btn.getAttribute('data-tab-from'));
          if (from < tabOrder.length - 1) {
            formStore.reorderTabItem(curPage, from, from + 1);
            updateFormInspector(field.id);
            if (currentRenderViewport) {
              pdfFormOverlayManager.renderFormOverlay(curPage, currentRenderViewport);
            }
          }
        });
      });
    }
  };

  let lastAuthorMode = false;
  let lastSelectedWidgetId: string | null = null;
  let lastFieldsCount = 0;
  let lastWidgetsCount = 0;

  formStore.subscribe((snapshot) => {
    const curState = editorStore.getState();
    const targetFieldId = snapshot.selectedWidgetId
      ? formStore.getWidget(snapshot.selectedWidgetId)?.fieldId
      : (snapshot.focusedFieldId || snapshot.activeFieldId);

    if (!editorStore.getSelectedObject() && !editorStore.getSelectedExistingTextId()) {
      if (targetFieldId) {
        updateFormInspector(targetFieldId);
      } else {
        if (paneFormField) paneFormField.classList.add('hidden');
      }
    }

    syncAuthorModeUI(snapshot.isAuthorMode);

    // Only do a structural re-render of overlay if mode, selection or field count changed
    const needsFullRerender =
      snapshot.isAuthorMode !== lastAuthorMode ||
      snapshot.selectedWidgetId !== lastSelectedWidgetId ||
      snapshot.fieldCount !== lastFieldsCount ||
      snapshot.widgetCount !== lastWidgetsCount;

    lastAuthorMode = snapshot.isAuthorMode;
    lastSelectedWidgetId = snapshot.selectedWidgetId;
    lastFieldsCount = snapshot.fieldCount;
    lastWidgetsCount = snapshot.widgetCount;

    if (needsFullRerender && currentRenderViewport && loadedDoc) {
      pdfFormOverlayManager.renderFormOverlay(curState.currentPage, currentRenderViewport);
    }
    pdfFormOverlayManager.syncDomValues();
  });

  // --- STATE STORE SUBSCRIPTION ---
  editorStore.subscribe((state) => {
    // Document metrics
    if (state.document) {
      if (docNameLabel) docNameLabel.textContent = state.document.name;
      if (docSizeLabel) docSizeLabel.textContent = `(${state.document.fileSizeFormatted})`;
      if (thumbnailPageCount) thumbnailPageCount.textContent = `${state.document.pageCount}`;
      if (bottomTotalPages) bottomTotalPages.textContent = `${state.document.pageCount}`;
      if (bottomCurrentPage) bottomCurrentPage.textContent = `${state.currentPage}`;
      if (docPropCurrentPage) docPropCurrentPage.textContent = `${state.currentPage} of ${state.document.pageCount}`;
      if (docPropFilename) docPropFilename.textContent = state.document.name;
      if (docPropFilesize) docPropFilesize.textContent = state.document.fileSizeFormatted;
      if (mobileThumbnailBadge) mobileThumbnailBadge.textContent = `${state.document.pageCount}`;

      const curPageInfo = state.document.pages[state.currentPage - 1];
      if (curPageInfo) {
        if (docPropDimensions) {
          docPropDimensions.textContent = `${curPageInfo.width} × ${curPageInfo.height} pt (${curPageInfo.orientation === 'portrait' ? 'A4' : 'Landscape'})`;
        }
        if (docPropOrientation) {
          docPropOrientation.textContent = curPageInfo.orientation === 'portrait' ? 'Portrait' : 'Landscape';
        }
        if (docPropRotation) {
          docPropRotation.textContent = `${curPageInfo.rotation}°`;
        }
      }

      // Check if page sequence or count changed to re-render thumbnails
      const currentPagesKey =
        JSON.stringify(state.document.pages.map((p) => `${p.id}-${p.rotation}-${p.pageNumber}`)) +
        `-${state.currentPage}`;
      if (currentPagesKey !== lastPagesKey && loadedDoc) {
        lastPagesKey = currentPagesKey;
        renderThumbnails(loadedDoc, state.currentPage);
      }
    }

    // Page button disabled states
    if (pagePrevBtn && state.document) {
      pagePrevBtn.disabled = state.currentPage <= 1;
    }
    if (pageNextBtn && state.document) {
      pageNextBtn.disabled = state.currentPage >= state.document.pageCount;
    }

    // Zoom displays
    if (zoomPercentText) {
      zoomPercentText.textContent = `${Math.round(state.viewport.zoom * 100)}%`;
    }
    if (docPropZoom) {
      docPropZoom.textContent = `${Math.round(state.viewport.zoom * 100)}%`;
    }

    // Active tool buttons
    toolButtons.forEach((btn) => {
      const tool = btn.getAttribute('data-tool');
      if (tool === state.activeTool) {
        btn.classList.add('bg-brand-50', 'text-brand-600', 'dark:bg-brand-950/80', 'dark:text-brand-400', 'border-brand-200', 'dark:border-brand-800');
        btn.classList.remove('text-slate-600', 'dark:text-slate-300', 'border-transparent');
      } else {
        btn.classList.remove('bg-brand-50', 'text-brand-600', 'dark:bg-brand-950/80', 'dark:text-brand-400', 'border-brand-200', 'dark:border-brand-800');
        btn.classList.add('text-slate-600', 'dark:text-slate-300', 'border-transparent');
      }
    });

    if (overlayLayer) {
      overlayLayer.style.pointerEvents = 'none';
    }
    if (pdfFormLayer) {
      pdfFormLayer.style.pointerEvents = 'none';
    }

    // Inspector Context Switching
    const selectedObj = editorStore.getSelectedObject();
    const selectedExistingTextId = state.selectedExistingTextId;
    const focusedFormFieldId = formStore.getFocusedFieldId();

    if (!selectedObj && !selectedExistingTextId) {
      if (focusedFormFieldId) {
        updateFormInspector(focusedFormFieldId);
      } else {
        if (inspectorTitle) inspectorTitle.textContent = 'Properties';
        if (inspectorBadge) inspectorBadge.textContent = 'Document';
        if (paneDocument) paneDocument.classList.remove('hidden');
        if (paneText) paneText.classList.add('hidden');
        if (paneShape) paneShape.classList.add('hidden');
        if (paneComment) paneComment.classList.add('hidden');
        if (paneRedact) paneRedact.classList.add('hidden');
        if (paneFormField) paneFormField.classList.add('hidden');
      }
    } else if (selectedExistingTextId) {
      if (paneFormField) paneFormField.classList.add('hidden');
      const item = pdfTextLayerManager.getTextItem(selectedExistingTextId);
      if (inspectorTitle) inspectorTitle.textContent = 'Existing Text';
      if (inspectorBadge) inspectorBadge.textContent = 'Original';
      if (paneDocument) paneDocument.classList.add('hidden');
      if (paneText) paneText.classList.remove('hidden');
      if (paneShape) paneShape.classList.add('hidden');
      if (paneComment) paneComment.classList.add('hidden');
      if (paneRedact) paneRedact.classList.add('hidden');

      if (item) {
        if (textFontFamily) textFontFamily.value = item.fontFamily;
        if (textFontSize) textFontSize.value = `${Math.round(item.fontSize)}`;
      }
    } else if (selectedObj && selectedObj.type === 'text') {
      if (paneFormField) paneFormField.classList.add('hidden');
      const textObj = selectedObj as TextEditorObject;
      if (inspectorTitle) inspectorTitle.textContent = 'Text Properties';
      if (inspectorBadge) inspectorBadge.textContent = 'Text';
      if (paneDocument) paneDocument.classList.add('hidden');
      if (paneText) paneText.classList.remove('hidden');
      if (paneShape) paneShape.classList.add('hidden');
      if (paneComment) paneComment.classList.add('hidden');
      if (paneRedact) paneRedact.classList.add('hidden');

      if (textFontFamily) textFontFamily.value = textObj.fontFamily;
      if (textFontSize) textFontSize.value = `${textObj.fontSize}`;
      if (textBoldBtn) {
        textBoldBtn.classList.toggle('bg-brand-100', textObj.fontWeight === 'bold');
        textBoldBtn.classList.toggle('dark:bg-brand-950', textObj.fontWeight === 'bold');
      }
      if (textItalicBtn) {
        textItalicBtn.classList.toggle('bg-brand-100', textObj.fontStyle === 'italic');
        textItalicBtn.classList.toggle('dark:bg-brand-950', textObj.fontStyle === 'italic');
      }
      if (textUnderlineBtn) {
        textUnderlineBtn.classList.toggle('bg-brand-100', textObj.textDecoration === 'underline');
        textUnderlineBtn.classList.toggle('dark:bg-brand-950', textObj.textDecoration === 'underline');
      }
      if (textOpacitySlider) textOpacitySlider.value = `${Math.round(textObj.opacity * 100)}`;
      if (textOpacityVal) textOpacityVal.textContent = `${Math.round(textObj.opacity * 100)}%`;
    } else if (selectedObj && selectedObj.type === 'text-replacement') {
      if (paneFormField) paneFormField.classList.add('hidden');
      const repObj = selectedObj as TextReplacementEditorObject;
      if (inspectorTitle) inspectorTitle.textContent = 'Text Replacement';
      if (inspectorBadge) inspectorBadge.textContent = 'Replacement';
      if (paneDocument) paneDocument.classList.add('hidden');
      if (paneText) paneText.classList.remove('hidden');
      if (paneShape) paneShape.classList.add('hidden');
      if (paneComment) paneComment.classList.add('hidden');
      if (paneRedact) paneRedact.classList.add('hidden');

      if (textFontFamily) textFontFamily.value = repObj.fontFamily;
      if (textFontSize) textFontSize.value = `${repObj.fontSize}`;
      if (textBoldBtn) {
        textBoldBtn.classList.toggle('bg-brand-100', repObj.fontWeight === 'bold');
        textBoldBtn.classList.toggle('dark:bg-brand-950', repObj.fontWeight === 'bold');
      }
      if (textItalicBtn) {
        textItalicBtn.classList.toggle('bg-brand-100', repObj.fontStyle === 'italic');
        textItalicBtn.classList.toggle('dark:bg-brand-950', repObj.fontStyle === 'italic');
      }
      if (textUnderlineBtn) {
        textUnderlineBtn.classList.toggle('bg-brand-100', repObj.textDecoration === 'underline');
        textUnderlineBtn.classList.toggle('dark:bg-brand-950', repObj.textDecoration === 'underline');
      }
      if (textOpacitySlider) textOpacitySlider.value = `${Math.round(repObj.opacity * 100)}`;
      if (textOpacityVal) textOpacityVal.textContent = `${Math.round(repObj.opacity * 100)}%`;
    } else if (selectedObj && (selectedObj.type === 'rectangle' || selectedObj.type === 'ellipse')) {
      if (paneFormField) paneFormField.classList.add('hidden');
      const shapeObj = selectedObj as ShapeEditorObject;
      if (inspectorTitle) inspectorTitle.textContent = 'Shape Properties';
      if (inspectorBadge) inspectorBadge.textContent = 'Shape';
      if (paneDocument) paneDocument.classList.add('hidden');
      if (paneText) paneText.classList.add('hidden');
      if (paneShape) paneShape.classList.remove('hidden');
      if (paneComment) paneComment.classList.add('hidden');
      if (paneRedact) paneRedact.classList.add('hidden');

      if (shapeStrokeWidth) shapeStrokeWidth.value = `${shapeObj.strokeWidth}`;
      if (shapeStrokeVal) shapeStrokeVal.textContent = `${shapeObj.strokeWidth} px`;
      if (shapeRadiusSlider) shapeRadiusSlider.value = `${shapeObj.borderRadius || 0}`;
      if (shapeRadiusVal) shapeRadiusVal.textContent = `${shapeObj.borderRadius || 0} px`;
    } else if (selectedObj && selectedObj.type === 'comment') {
      if (paneFormField) paneFormField.classList.add('hidden');
      const annObj = selectedObj as AnnotationEditorObject;
      if (inspectorTitle) inspectorTitle.textContent = 'Comment Note';
      if (inspectorBadge) inspectorBadge.textContent = 'Comment';
      if (paneDocument) paneDocument.classList.add('hidden');
      if (paneText) paneText.classList.add('hidden');
      if (paneShape) paneShape.classList.add('hidden');
      if (paneComment) paneComment.classList.remove('hidden');
      if (paneRedact) paneRedact.classList.add('hidden');

      if (commentPropText && document.activeElement !== commentPropText) {
        commentPropText.value = annObj.commentText || '';
      }
      if (commentPropAuthor) {
        commentPropAuthor.textContent = annObj.author || 'User';
      }
      if (commentPropTime) {
        commentPropTime.textContent = annObj.createdAt
          ? new Date(annObj.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          : 'Just now';
      }
    } else if (selectedObj && selectedObj.type === 'redact') {
      if (paneFormField) paneFormField.classList.add('hidden');
      const redObj = selectedObj as RedactionEditorObject;
      if (inspectorTitle) inspectorTitle.textContent = 'Redaction Region';
      if (inspectorBadge) inspectorBadge.textContent = 'Draft';
      if (paneDocument) paneDocument.classList.add('hidden');
      if (paneText) paneText.classList.add('hidden');
      if (paneShape) paneShape.classList.add('hidden');
      if (paneComment) paneComment.classList.add('hidden');
      if (paneRedact) paneRedact.classList.remove('hidden');

      if (redactPropOverlayText && document.activeElement !== redactPropOverlayText) {
        redactPropOverlayText.value = redObj.overlayText || '';
      }
      if (redactColorBlack && redactColorWhite) {
        const isWhite = redObj.fillColor && redObj.fillColor.toLowerCase() === '#ffffff';
        redactColorWhite.classList.toggle('border-2', isWhite);
        redactColorWhite.classList.toggle('border-brand-500', isWhite);
        redactColorBlack.classList.toggle('border-2', !isWhite);
        redactColorBlack.classList.toggle('border-brand-500', !isWhite);
      }
    }

    // Trigger page re-render if loaded
    triggerPageRender();
  });

  // Initial theme check on mount
  syncThemeUI();
</script>
