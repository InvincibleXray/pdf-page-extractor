---
---

<div id="editor-upload-container" class="w-full max-w-4xl mx-auto py-8 sm:py-12 transition-all duration-200">
  <!-- Privacy Positioning Badge -->
  <div class="flex justify-center mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200/80 dark:border-emerald-800/60">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-xs font-semibold text-emerald-800 dark:text-emerald-300">
        Private PDF Editing — No Upload Required
      </span>
    </div>
  </div>

  <!-- Header & Description -->
  <div class="text-center max-w-2xl mx-auto mb-10 px-4">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.12] text-slate-900 dark:text-white">
      Edit PDF <br />
      <span class="text-brand-600 dark:text-brand-500">Directly in Browser</span>
    </h1>
    <p class="mt-4 text-sm sm:text-base font-medium text-slate-600 dark:text-slate-300 leading-relaxed">
      Add text, highlights, drawings, annotations, and redactions locally on your device. Fast, secure, and zero data leaves your browser.
    </p>
  </div>

  <!-- Primary Upload Card -->
  <div class="bg-white dark:bg-[#141a24] border border-slate-200/80 dark:border-[#212b3c] rounded-3xl p-6 sm:p-10 shadow-card-light dark:shadow-card-dark transition-all duration-200">
    <div
      id="editor-drop-zone"
      tabindex="0"
      role="button"
      aria-label="Upload PDF to edit"
      class="custom-dashed-border group cursor-pointer p-10 sm:p-14 flex flex-col items-center justify-center text-center transition-all duration-200 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 dark:focus:ring-offset-[#141a24]"
    >
      <input type="file" id="editor-file-input" accept=".pdf,application/pdf" class="hidden" />

      <!-- Upload Cloud Icon -->
      <div class="w-14 h-14 mb-4 text-slate-700 dark:text-slate-200 transition-transform group-hover:-translate-y-1 duration-200">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
          <path d="M12 12v9" />
          <path d="m16 16-4-4-4 4" />
        </svg>
      </div>

      <p class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
        Drop your PDF file here
      </p>
      <p class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400 mt-1.5">
        Supports all standard .pdf documents • Click to browse
      </p>

      <!-- Instant Demo Document Trigger -->
      <div class="mt-6 pt-5 border-t border-slate-200/60 dark:border-[#212b3c] w-full max-w-sm flex flex-col items-center">
        <button
          type="button"
          id="editor-sample-btn"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/60 hover:bg-brand-100 dark:hover:bg-brand-900/60 border border-brand-200/70 dark:border-brand-800/60 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <line x1="10" y1="9" x2="8" y2="9" />
          </svg>
          Open Sample PDF Document
        </button>
        <span class="text-[11px] text-slate-400 dark:text-slate-500 mt-2">
          Test tools immediately without uploading your own file
        </span>
      </div>
    </div>

    <!-- Privacy & Feature Badges -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 pt-6 border-t border-slate-100 dark:border-[#1d2636]">
      <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-[#101621] border border-slate-100 dark:border-[#1b2434]">
        <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-xs font-bold text-slate-900 dark:text-white">100% In-Browser</h2>
          <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Zero network uploads</p>
        </div>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-[#101621] border border-slate-100 dark:border-[#1b2434]">
        <div class="w-8 h-8 rounded-lg bg-brand-100 dark:bg-brand-950/80 text-brand-600 dark:text-brand-400 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
        </div>
        <div>
          <h2 class="text-xs font-bold text-slate-900 dark:text-white">Visual Tools</h2>
          <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Text, markup & shapes</p>
        </div>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-[#101621] border border-slate-100 dark:border-[#1b2434]">
        <div class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <div>
          <h2 class="text-xs font-bold text-slate-900 dark:text-white">Confidentiality</h2>
          <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Redact & whiteout data</p>
        </div>
      </div>
    </div>
  </div>
</div>
