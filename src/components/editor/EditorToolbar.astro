---
---

<div class="w-full bg-slate-50/90 dark:bg-[#101621] border-b border-slate-200/80 dark:border-[#212b3c] px-3 sm:px-6 py-2 flex items-center justify-between gap-2 overflow-x-auto no-scrollbar z-20 transition-colors duration-200">
  <!-- Left Side: History & Tool Groups -->
  <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
    <!-- Undo / Redo Group -->
    <div class="flex items-center gap-0.5 p-1 rounded-xl bg-white dark:bg-[#161c28] border border-slate-200/60 dark:border-[#212836] shadow-2xs">
      <button
        type="button"
        id="tool-undo-btn"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors disabled:opacity-30 disabled:pointer-events-none"
        title="Undo (Ctrl+Z)"
        aria-label="Undo"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 7v6h6" />
          <path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13" />
        </svg>
      </button>
      <button
        type="button"
        id="tool-redo-btn"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors disabled:opacity-30 disabled:pointer-events-none"
        title="Redo (Ctrl+Y)"
        aria-label="Redo"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 7v6h-6" />
          <path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7" />
        </svg>
      </button>
    </div>

    <div class="h-5 w-px bg-slate-200 dark:bg-slate-700"></div>

    <!-- Group 1: Selection & Content -->
    <div class="flex items-center gap-0.5 p-1 rounded-xl bg-white dark:bg-[#161c28] border border-slate-200/60 dark:border-[#212836] shadow-2xs">
      <!-- Select Tool -->
      <button
        type="button"
        data-tool="select"
        class="editor-tool-btn px-2.5 h-8 rounded-lg flex items-center gap-1.5 text-xs font-semibold transition-all border"
        title="Select & Move Objects (V)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z" />
          <path d="M13 13l6 6" />
        </svg>
        <span class="hidden md:inline">Select</span>
      </button>

      <!-- Text Tool -->
      <button
        type="button"
        data-tool="text"
        class="editor-tool-btn px-2.5 h-8 rounded-lg flex items-center gap-1.5 text-xs font-semibold transition-all border"
        title="Add Text (T)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="4 7 4 4 20 4 20 7" />
          <line x1="9" y1="20" x2="15" y2="20" />
          <line x1="12" y1="4" x2="12" y2="20" />
        </svg>
        <span class="hidden md:inline">Text</span>
      </button>

      <!-- Image Tool -->
      <button
        type="button"
        data-tool="image"
        class="editor-tool-btn px-2 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Insert Image (I)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <polyline points="21 15 16 10 5 21" />
        </svg>
      </button>
    </div>

    <!-- Group 2: Annotations -->
    <div class="flex items-center gap-0.5 p-1 rounded-xl bg-white dark:bg-[#161c28] border border-slate-200/60 dark:border-[#212836] shadow-2xs">
      <!-- Highlight -->
      <button
        type="button"
        data-tool="highlight"
        class="editor-tool-btn px-2.5 h-8 rounded-lg flex items-center gap-1.5 text-xs font-semibold transition-all border"
        title="Highlight Text (H)"
      >
        <svg class="w-3.5 h-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m9 11-6 6v3h3l6-6" />
          <path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4" />
        </svg>
        <span class="hidden lg:inline">Highlight</span>
      </button>

      <!-- Underline -->
      <button
        type="button"
        data-tool="underline"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Underline Text (U)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 3v7a6 6 0 0 0 12 0V3" />
          <line x1="4" y1="21" x2="20" y2="21" />
        </svg>
      </button>

      <!-- Strikethrough -->
      <button
        type="button"
        data-tool="strikethrough"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Strikethrough (S)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 4H9a3 3 0 0 0-2.83 4" />
          <path d="M14 12a4 4 0 0 1 0 8H6" />
          <line x1="4" y1="12" x2="20" y2="12" />
        </svg>
      </button>

      <!-- Comment Note -->
      <button
        type="button"
        data-tool="comment"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Sticky Comment (C)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
      </button>
    </div>

    <!-- Group 3: Shapes & Drawing -->
    <div class="flex items-center gap-0.5 p-1 rounded-xl bg-white dark:bg-[#161c28] border border-slate-200/60 dark:border-[#212836] shadow-2xs">
      <!-- Pen / Freehand -->
      <button
        type="button"
        data-tool="pen"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Draw / Pen (P)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 19l7-7 3 3-7 7-3-3z" />
          <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
          <path d="M2 2l7.586 7.586" />
          <circle cx="11" cy="11" r="2" />
        </svg>
      </button>

      <!-- Line -->
      <button
        type="button"
        data-tool="line"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Line (L)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="19" x2="19" y2="5" />
        </svg>
      </button>

      <!-- Arrow -->
      <button
        type="button"
        data-tool="arrow"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Arrow (A)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </button>

      <!-- Rectangle -->
      <button
        type="button"
        data-tool="rectangle"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Rectangle (R)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" />
        </svg>
      </button>

      <!-- Ellipse -->
      <button
        type="button"
        data-tool="ellipse"
        class="editor-tool-btn w-8 h-8 rounded-lg flex items-center justify-center text-xs font-semibold transition-all border"
        title="Circle / Ellipse (O)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" />
        </svg>
      </button>
    </div>

    <!-- Group 4: Privacy & Signature -->
    <div class="flex items-center gap-0.5 p-1 rounded-xl bg-white dark:bg-[#161c28] border border-slate-200/60 dark:border-[#212836] shadow-2xs">
      <!-- Whiteout -->
      <button
        type="button"
        data-tool="whiteout"
        class="editor-tool-btn px-2 h-8 rounded-lg flex items-center gap-1 text-xs font-semibold transition-all border"
        title="Whiteout Area (W)"
      >
        <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="4" y="4" width="16" height="16" rx="2" stroke-dasharray="3 3"/>
        </svg>
        <span class="hidden xl:inline text-[11px]">Whiteout</span>
      </button>

      <!-- Redact -->
      <button
        type="button"
        data-tool="redact"
        class="editor-tool-btn px-2 h-8 rounded-lg flex items-center gap-1 text-xs font-semibold transition-all border"
        title="Redact Confidential Data (X)"
      >
        <svg class="w-3.5 h-3.5 text-slate-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor">
          <rect x="4" y="4" width="16" height="16" rx="2"/>
        </svg>
        <span class="hidden xl:inline text-[11px]">Redact</span>
      </button>

      <!-- Signature -->
      <button
        type="button"
        data-tool="signature"
        class="editor-tool-btn px-2.5 h-8 rounded-lg flex items-center gap-1.5 text-xs font-semibold transition-all border"
        title="Add Signature"
      >
        <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 17c3-3 6-5 9-2s4 4 7 1" />
          <path d="M14 6l6 6" />
        </svg>
        <span class="hidden sm:inline">Sign</span>
      </button>
    </div>

    <!-- More Options Popover -->
    <div class="relative">
      <button
        type="button"
        id="tool-more-btn"
        class="h-8 px-2.5 rounded-xl bg-white dark:bg-[#161c28] border border-slate-200/60 dark:border-[#212836] text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white flex items-center gap-1 text-xs font-semibold shadow-2xs transition-colors"
        title="More Tools"
      >
        <span>More</span>
        <svg class="w-3 h-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>

      <!-- Dropdown Content -->
      <div
        id="tool-more-menu"
        class="hidden absolute left-0 top-full mt-1.5 w-44 rounded-xl bg-white dark:bg-[#161c28] border border-slate-200 dark:border-[#212836] shadow-lg p-1.5 z-50 text-xs font-medium"
      >
        <button type="button" class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/60 flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          Add Hyperlink
        </button>
        <button type="button" class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/60 flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Add Watermark
        </button>
        <button type="button" class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/60 flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          Page Numbers
        </button>
        <button type="button" class="w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/60 flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg>
          Crop Page
        </button>
      </div>
    </div>
  </div>

  <!-- Right Side: Sidebar Toggle Icons (Desktop) -->
  <div class="flex items-center gap-1.5 flex-shrink-0">
    <!-- Toggle Thumbnails Sidebar -->
    <button
      type="button"
      id="toggle-thumbnails-btn"
      class="h-8 px-2 rounded-xl text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-white dark:hover:bg-[#161c28] border border-transparent hover:border-slate-200/60 dark:hover:border-[#212836] text-xs font-semibold flex items-center gap-1 transition-all"
      title="Toggle Thumbnails Sidebar"
      aria-label="Toggle Thumbnails"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="9" y1="3" x2="9" y2="21" />
      </svg>
      <span class="hidden xl:inline">Pages</span>
    </button>

    <!-- Toggle Inspector Panel -->
    <button
      type="button"
      id="toggle-inspector-btn"
      class="h-8 px-2 rounded-xl text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-white dark:hover:bg-[#161c28] border border-transparent hover:border-slate-200/60 dark:hover:border-[#212836] text-xs font-semibold flex items-center gap-1 transition-all"
      title="Toggle Properties Inspector"
      aria-label="Toggle Inspector"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="15" y1="3" x2="15" y2="21" />
      </svg>
      <span class="hidden xl:inline">Properties</span>
    </button>
  </div>
</div>
