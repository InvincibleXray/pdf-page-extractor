---
---

<aside
  id="editor-thumbnails-sidebar"
  class="w-56 lg:w-64 flex-shrink-0 bg-white dark:bg-[#141a24] border-r border-slate-200/80 dark:border-[#212b3c] flex flex-col h-full z-10 transition-all duration-200"
>
  <!-- Sidebar Header -->
  <div class="p-3.5 border-b border-slate-200/70 dark:border-[#212b3c] flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">
        Pages
      </span>
      <span id="thumbnail-page-count" class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
        3
      </span>
    </div>

    <!-- Add Page Button -->
    <button
      type="button"
      id="add-page-btn"
      class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-semibold text-brand-600 dark:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-950/60 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
      title="Add blank page (Future Phase)"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14" />
      </svg>
      <span>Add</span>
    </button>
  </div>

  <!-- Scrollable Thumbnail List -->
  <div id="thumbnails-container" class="flex-1 overflow-y-auto p-4 space-y-4">
    <!-- Dynamic thumbnails will be rendered and synchronized here by JS -->
    <!-- Template placeholder: -->
    <div class="thumbnail-item group relative cursor-pointer flex flex-col items-center">
      <div
        class="w-36 h-48 rounded-xl bg-white dark:bg-[#1a2232] border-2 border-brand-500 shadow-sm transition-all p-3 flex flex-col justify-between overflow-hidden relative"
      >
        <!-- Mock page content lines -->
        <div class="space-y-1.5 opacity-60">
          <div class="h-2 w-3/4 bg-slate-300 dark:bg-slate-600 rounded"></div>
          <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-700 rounded"></div>
          <div class="h-1.5 w-5/6 bg-slate-200 dark:bg-slate-700 rounded"></div>
          <div class="h-1.5 w-4/5 bg-slate-200 dark:bg-slate-700 rounded"></div>
        </div>
        <div class="text-[9px] font-mono text-slate-400 text-right">Page 1</div>
      </div>
      <div class="flex items-center justify-between w-36 mt-1.5 px-1">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300">1</span>
        <!-- Context Menu Button -->
        <button
          type="button"
          class="p-1 rounded text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          title="Page Options"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="1" />
            <circle cx="12" cy="5" r="1" />
            <circle cx="12" cy="19" r="1" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Contextual Page Actions Menu (Floating Template) -->
  <div
    id="thumbnail-context-menu"
    class="hidden fixed bg-white dark:bg-[#161c28] border border-slate-200 dark:border-[#212836] rounded-xl shadow-xl py-1.5 z-50 text-xs w-36 font-medium"
  >
    <button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-700/60 flex items-center gap-2 text-slate-700 dark:text-slate-200">
      <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8"/><path d="M21 3v5h-5"/></svg>
      Rotate 90°
    </button>
    <button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-700/60 flex items-center gap-2 text-slate-700 dark:text-slate-200">
      <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      Duplicate
    </button>
    <div class="h-px bg-slate-200 dark:bg-slate-700 my-1"></div>
    <button type="button" class="w-full text-left px-3 py-1.5 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center gap-2">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
      Delete
    </button>
  </div>
</aside>
