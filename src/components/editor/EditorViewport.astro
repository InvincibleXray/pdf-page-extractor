---
---

<div
  id="editor-viewport"
  class="flex-1 h-full overflow-auto bg-slate-100/70 dark:bg-[#090d14] relative flex p-3 sm:p-12 select-none transition-colors duration-200"
  tabindex="0"
>
  <!-- Zoom & Scale Container -->
  <div id="viewport-scale-container" class="transition-transform duration-100 origin-top m-auto flex justify-center flex-shrink-0">
    <!-- PDF Document Page Wrapper -->
    <div
      id="pdf-page-card"
      class="w-[595px] h-[842px] bg-white border border-slate-200/90 dark:border-[#212b3c] shadow-2xl shadow-slate-400/20 dark:shadow-black/80 relative rounded-xs flex-shrink-0 transition-all duration-150 text-slate-900"
      style="width: 595px; height: 842px;"
    >
      <!-- LAYER 1: PDF Base Rendering Layer -->
      <div id="pdf-render-layer" class="absolute inset-0 overflow-hidden pointer-events-none flex items-center justify-center z-0">
        <canvas id="pdf-canvas" class="block bg-white pointer-events-auto"></canvas>
      </div>

      <!-- LAYER 2: PDF.js Text Layer (Transparent selectable text spans) -->
      <div
        id="pdf-text-layer"
        class="textLayer absolute inset-0 overflow-hidden pointer-events-none z-10"
      ></div>

      <!-- LAYER 3: Interactive Editor Overlay Layer -->
      <div
        id="editor-overlay-layer"
        class="absolute inset-0 overflow-hidden pointer-events-none z-20"
      >
        <!-- Overlay objects rendered dynamically here -->
      </div>

      <!-- LAYER 4: Interactive Accessible Form Overlay Layer -->
      <div
        id="pdf-form-layer"
        class="absolute inset-0 overflow-hidden pointer-events-none z-30"
      ></div>

      <!-- LAYER 5: Selection Bounding Box & Transform Handles (Single active selection box) -->
      <div
        id="selection-bounding-box"
        class="hidden absolute border-2 border-brand-500 pointer-events-none z-40 transition-all duration-75"
      >
        <!-- Corner Handles -->
        <div data-handle="nw" class="handle-nw absolute -top-1.5 -left-1.5 w-3 h-3 bg-white border-2 border-brand-500 rounded-xs shadow-xs pointer-events-auto cursor-nwse-resize"></div>
        <div data-handle="ne" class="handle-ne absolute -top-1.5 -right-1.5 w-3 h-3 bg-white border-2 border-brand-500 rounded-xs shadow-xs pointer-events-auto cursor-nesw-resize"></div>
        <div data-handle="se" class="handle-se absolute -bottom-1.5 -right-1.5 w-3 h-3 bg-white border-2 border-brand-500 rounded-xs shadow-xs pointer-events-auto cursor-nwse-resize"></div>
        <div data-handle="sw" class="handle-sw absolute -bottom-1.5 -left-1.5 w-3 h-3 bg-white border-2 border-brand-500 rounded-xs shadow-xs pointer-events-auto cursor-nesw-resize"></div>

        <!-- Rotation Stem & Handle -->
        <div class="absolute -top-6 left-1/2 -translate-x-1/2 flex flex-col items-center pointer-events-auto cursor-grab">
          <div class="w-3 h-3 rounded-full bg-white border-2 border-brand-500 shadow-xs"></div>
          <div class="w-0.5 h-3 bg-brand-500"></div>
        </div>
      </div>

      <!-- LAYER 5: Existing Text Action Bar (Dynamic contextual control surface) -->
      <div
        id="existing-text-action-bar"
        class="hidden absolute z-40 flex items-center gap-1 p-1 bg-white dark:bg-[#161c28] border border-slate-200 dark:border-[#212836] rounded-xl shadow-xl transition-opacity duration-150 pointer-events-auto select-none max-w-[calc(100vw-16px)] overflow-x-auto touch-manipulation"
        role="toolbar"
        aria-label="Text contextual actions"
      >
        <button
          type="button"
          id="edit-existing-text-btn"
          class="px-2.5 py-1 lg:px-2.5 lg:py-1 min-h-[44px] lg:min-h-[32px] text-xs font-semibold text-brand-600 dark:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-950/60 rounded-lg flex items-center gap-1.5 transition-colors touch-manipulation focus:outline-none focus:ring-2 focus:ring-brand-500"
          title="Edit text"
          aria-label="Edit text"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
          </svg>
          <span>Edit</span>
        </button>

        <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

        <button
          type="button"
          id="underline-existing-text-btn"
          class="px-2.5 py-1 lg:px-2 lg:py-1 min-h-[44px] lg:min-h-[32px] text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg flex items-center gap-1 transition-colors touch-manipulation focus:outline-none focus:ring-2 focus:ring-brand-500"
          title="Underline text"
          aria-label="Underline text"
        >
          <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 3v7a6 6 0 0 0 12 0V3" />
            <line x1="4" y1="21" x2="20" y2="21" />
          </svg>
          <span>Underline</span>
        </button>

        <button
          type="button"
          id="strikethrough-existing-text-btn"
          class="px-2.5 py-1 lg:px-2 lg:py-1 min-h-[44px] lg:min-h-[32px] text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg flex items-center gap-1 transition-colors touch-manipulation focus:outline-none focus:ring-2 focus:ring-brand-500"
          title="Strikethrough text"
          aria-label="Strikethrough text"
        >
          <svg class="w-3.5 h-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 4H9a3 3 0 0 0-2.83 4" />
            <path d="M14 12a4 4 0 0 1 0 8H6" />
            <line x1="4" y1="12" x2="20" y2="12" />
          </svg>
          <span>Strike</span>
        </button>

        <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

        <button
          type="button"
          id="redact-existing-text-btn"
          class="px-2.5 py-1 lg:px-2 lg:py-1 min-h-[44px] lg:min-h-[32px] text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/60 rounded-lg flex items-center gap-1 transition-colors touch-manipulation focus:outline-none focus:ring-2 focus:ring-brand-500"
          title="Redact text permanently"
          aria-label="Redact text permanently"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
          </svg>
          <span>Redact</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* PDF.js TextLayer Styling */
  .textLayer {
    position: absolute;
    text-align: initial;
    inset: 0;
    overflow: clip;
    opacity: 1;
    line-height: 1;
    -webkit-text-size-adjust: none;
    -moz-text-size-adjust: none;
    text-size-adjust: none;
    forced-color-adjust: none;
    transform-origin: 0 0;
    caret-color: #2563eb;
    z-index: 5;
  }
  .textLayer :is(span, br) {
    color: transparent;
    position: absolute;
    white-space: pre;
    cursor: text;
    transform-origin: 0% 0%;
  }
  .textLayer span.markedContent {
    top: 0;
    height: 0;
  }
  .textLayer span[role="img"] {
    user-select: none;
    cursor: default;
  }
  .textLayer ::selection {
    background: rgba(37, 99, 235, 0.25);
  }
  /* Highlight selected existing PDF text span */
  .text-item-selected {
    outline: 2px dashed #2563eb !important;
    background: rgba(37, 99, 235, 0.12) !important;
    border-radius: 2px;
  }
</style>
