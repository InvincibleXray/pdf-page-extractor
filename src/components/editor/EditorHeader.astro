---
---

<header class="w-full bg-white dark:bg-[#141a24] border-b border-slate-200/80 dark:border-[#212b3c] px-4 sm:px-6 py-3 flex items-center justify-between z-30 transition-colors duration-200">
  <!-- Left: Return & Branding -->
  <div class="flex items-center gap-3 sm:gap-4">
    <a
      href="/"
      id="editor-back-btn"
      class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
      title="Back to PDF Extractor"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      <span class="hidden sm:inline">Extractor</span>
    </a>

    <div class="h-4 w-px bg-slate-200 dark:bg-slate-700 hidden sm:block"></div>

    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 flex items-center justify-center shadow-xs">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 20h9"/>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold text-slate-900 dark:text-white tracking-tight">PDF Editor</span>
        <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400 hidden md:inline-flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> In-Memory • Local
        </span>
      </div>
    </div>
  </div>

  <!-- Center: Document Context -->
  <div class="hidden sm:flex items-center gap-2 max-w-xs md:max-w-md truncate px-2">
    <div class="w-6 h-6 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center flex-shrink-0">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
      </svg>
    </div>
    <span id="editor-doc-name" class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white truncate">
      Document.pdf
    </span>
    <span id="editor-doc-size" class="text-[11px] font-medium text-slate-400 dark:text-slate-500 hidden sm:inline">
      (0 KB)
    </span>
  </div>

  <!-- Right: Actions & Theme Toggle -->
  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Secondary Menu / Reset Action -->
    <button
      type="button"
      id="editor-new-doc-btn"
      class="p-2 sm:px-3 sm:py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500 flex items-center gap-1.5"
      title="Open Another PDF Document"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14" />
      </svg>
      <span class="hidden md:inline">Open New</span>
    </button>

    <!-- Primary Export Action -->
    <button
      type="button"
      id="editor-export-btn"
      class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-600 hover:bg-brand-700 active:scale-[0.98] text-white shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 dark:focus:ring-offset-[#141a24]"
      title="Export edited PDF (Phase 1 preview)"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      <span>Export PDF</span>
    </button>

    <!-- Theme Switch Pill -->
    <div class="pl-2 border-l border-slate-200 dark:border-slate-700 flex items-center">
      <button
        id="editor-theme-toggle-btn"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Toggle dark/light mode"
        class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-slate-300 dark:bg-slate-700 transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-brand-500"
      >
        <span
          id="editor-theme-knob"
          class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0 dark:translate-x-5"
        ></span>
      </button>
    </div>
  </div>
</header>
