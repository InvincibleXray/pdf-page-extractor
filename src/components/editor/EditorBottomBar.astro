---
---

<div class="absolute bottom-16 md:bottom-5 left-1/2 -translate-x-1/2 z-20 flex items-center justify-center pointer-events-none">
  <div
    class="pointer-events-auto bg-white/95 dark:bg-[#141a24]/95 backdrop-blur-md border border-slate-200/90 dark:border-[#243044] shadow-lg shadow-slate-900/5 dark:shadow-black/60 rounded-full px-3 py-1.5 flex items-center gap-1.5 sm:gap-2 text-xs font-semibold text-slate-700 dark:text-slate-200 transition-all duration-200 max-w-[95vw] overflow-x-auto no-scrollbar"
    role="toolbar"
    aria-label="Viewport and page navigation controls"
  >
    <!-- Zoom Out -->
    <button
      type="button"
      id="zoom-out-btn"
      class="w-7 h-7 rounded-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
      title="Zoom Out (Ctrl+-)"
      aria-label="Zoom Out"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
    </button>

    <!-- Zoom Percent (Click to Reset 100%) -->
    <button
      type="button"
      id="zoom-percent-btn"
      class="px-2 py-0.5 rounded-lg text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 font-mono text-[11px] sm:text-xs transition-colors"
      title="Click to reset zoom to 100%"
    >
      <span id="zoom-percent-text">100%</span>
    </button>

    <!-- Zoom In -->
    <button
      type="button"
      id="zoom-in-btn"
      class="w-7 h-7 rounded-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
      title="Zoom In (Ctrl++)"
      aria-label="Zoom In"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
    </button>

    <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

    <!-- Fit Page -->
    <button
      type="button"
      id="zoom-fit-page-btn"
      class="px-2 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-[11px] text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors hidden sm:inline-block"
      title="Fit entire page to view"
    >
      Fit Page
    </button>

    <!-- Fit Width -->
    <button
      type="button"
      id="zoom-fit-width-btn"
      class="px-2 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-[11px] text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors hidden sm:inline-block"
      title="Fit page width"
    >
      Fit Width
    </button>

    <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

    <!-- Page Nav: Prev -->
    <button
      type="button"
      id="page-prev-btn"
      class="w-7 h-7 rounded-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors disabled:opacity-30 disabled:pointer-events-none focus:outline-none focus:ring-2 focus:ring-brand-500"
      title="Previous Page"
      aria-label="Previous Page"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    <!-- Page Indicator -->
    <div class="flex items-center gap-1 font-mono text-[11px] sm:text-xs text-slate-800 dark:text-slate-200 px-1">
      <span id="bottom-current-page">1</span>
      <span class="text-slate-400">/</span>
      <span id="bottom-total-pages" class="text-slate-500 dark:text-slate-400">3</span>
    </div>

    <!-- Page Nav: Next -->
    <button
      type="button"
      id="page-next-btn"
      class="w-7 h-7 rounded-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors disabled:opacity-30 disabled:pointer-events-none focus:outline-none focus:ring-2 focus:ring-brand-500"
      title="Next Page"
      aria-label="Next Page"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>

    <div class="h-4 w-px bg-slate-200 dark:bg-slate-700"></div>

    <!-- Fullscreen Toggle -->
    <button
      type="button"
      id="fullscreen-toggle-btn"
      class="w-7 h-7 rounded-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
      title="Toggle Fullscreen"
      aria-label="Toggle Fullscreen"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
      </svg>
    </button>
  </div>
</div>
