---
---

<!-- Mobile Darkened Backdrop -->
<div
  id="mobile-sheet-backdrop"
  class="hidden fixed inset-0 bg-slate-900/60 dark:bg-black/70 backdrop-blur-xs z-40 transition-opacity duration-200 opacity-0"
  aria-hidden="true"
></div>

<!-- Mobile Thumbnails Drawer (Slides in from Left) -->
<div
  id="mobile-thumbnails-drawer"
  class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-white dark:bg-[#141a24] z-50 transform -translate-x-full transition-transform duration-250 ease-out shadow-2xl flex flex-col md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Pages thumbnail drawer"
>
  <!-- Drawer Header -->
  <div class="p-4 border-b border-slate-200 dark:border-[#212b3c] flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-sm font-bold text-slate-900 dark:text-white">Document Pages</span>
      <span id="mobile-thumbnail-badge" class="px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
        3
      </span>
    </div>
    <!-- 44px touch target close button -->
    <button
      type="button"
      id="close-mobile-drawer-btn"
      class="w-11 h-11 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
      aria-label="Close pages drawer"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Thumbnails Scroll Area -->
  <div id="mobile-thumbnails-list" class="flex-1 overflow-y-auto p-4 space-y-4">
    <!-- Rendered dynamically -->
  </div>
</div>

<!-- Mobile Inspector Bottom Sheet (Slides up from Bottom) -->
<div
  id="mobile-inspector-sheet"
  class="fixed inset-x-0 bottom-0 max-h-[82vh] bg-white dark:bg-[#141a24] z-50 transform translate-y-full transition-transform duration-250 ease-out shadow-2xl rounded-t-3xl flex flex-col border-t border-slate-200 dark:border-[#212b3c] md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Object properties sheet"
>
  <!-- Drag Handle -->
  <div class="w-12 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600 mx-auto mt-3 mb-1"></div>

  <!-- Sheet Header -->
  <div class="px-5 py-3 border-b border-slate-200 dark:border-[#212b3c] flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span id="mobile-inspector-title" class="text-sm font-bold text-slate-900 dark:text-white">
        Properties
      </span>
      <span id="mobile-inspector-badge" class="px-2 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-600 dark:bg-brand-950/60 dark:text-brand-400">
        Text Object
      </span>
    </div>

    <!-- 44px touch target close button -->
    <button
      type="button"
      id="close-mobile-sheet-btn"
      class="w-11 h-11 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500"
      aria-label="Close properties sheet"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Inspector Scroll Area -->
  <div id="mobile-inspector-content" class="flex-1 overflow-y-auto p-5 space-y-4">
    <!-- Populated by JS based on selection -->
  </div>
</div>

<!-- Mobile Bottom Navigation Bar (Pages & Properties triggers) -->
<div class="fixed bottom-0 inset-x-0 bg-white/95 dark:bg-[#141a24]/95 border-t border-slate-200/80 dark:border-[#212b3c] px-4 py-2 flex items-center justify-around z-30 md:hidden backdrop-blur-md">
  <button
    type="button"
    id="mobile-open-pages-btn"
    class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 text-[11px] font-semibold"
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <line x1="9" y1="3" x2="9" y2="21" />
    </svg>
    <span>Pages</span>
  </button>

  <button
    type="button"
    id="mobile-open-inspector-btn"
    class="flex flex-col items-center justify-center gap-1 min-w-[56px] min-h-[44px] text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 text-[11px] font-semibold"
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <line x1="15" y1="3" x2="15" y2="21" />
    </svg>
    <span>Properties</span>
  </button>
</div>

<!-- Signature Pad Modal -->
<div
  id="signature-modal"
  class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 dark:bg-black/70 backdrop-blur-xs"
  role="dialog"
  aria-modal="true"
  aria-label="Draw your signature"
>
  <div class="bg-white dark:bg-[#1a2232] rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl p-6 w-full max-w-md flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 17c3-3 6-5 9-2s4 4 7 1" />
          <path d="M14 6l6 6" />
        </svg>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Draw Signature</h3>
      </div>
      <button
        type="button"
        id="close-sig-modal-btn"
        class="w-8 h-8 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Drawing canvas -->
    <div class="w-full h-44 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-[#101621] relative overflow-hidden flex items-center justify-center">
      <canvas id="sig-pad-canvas" width="400" height="160" class="w-full h-full cursor-crosshair touch-none"></canvas>
      <span id="sig-pad-hint" class="pointer-events-none absolute text-xs text-slate-400 select-none">Draw your signature here</span>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-2">
      <button
        type="button"
        id="clear-sig-btn"
        class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        Clear
      </button>
      <button
        type="button"
        id="save-sig-btn"
        class="px-5 py-2 rounded-xl text-xs font-bold bg-brand-600 hover:bg-brand-700 text-white shadow-sm transition-all"
      >
        Adopt & Place
      </button>
    </div>
  </div>
</div>

<!-- Hidden image file input -->
<input type="file" id="editor-image-file-input" accept="image/png,image/jpeg,image/webp" class="hidden" />
