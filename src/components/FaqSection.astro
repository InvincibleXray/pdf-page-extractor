---
const faqs = [
  {
    question: "Are my PDF files uploaded to a server?",
    answer: "No. Your PDF files are processed 100% locally inside your web browser. They are never transmitted over the network or uploaded to external servers."
  },
  {
    question: "Can I extract PDF pages without uploading?",
    answer: "Yes. This PDF page extractor runs client-side on your device, allowing you to select and extract page ranges completely privately without uploading documents."
  },
  {
    question: "Does this PDF extractor work locally on my device?",
    answer: "Yes. All page reading, range calculations, and PDF file generation happen within your browser's memory, making it fast and secure."
  },
  {
    question: "Is signup or registration required?",
    answer: "No signup or account creation is required. You can extract pages and download your PDF instantly."
  }
];

// Schema.org FAQPage structured data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="w-full max-w-4xl mx-auto mt-16 sm:mt-24 pt-12 border-t border-slate-200/80 dark:border-[#1e2738]">
  <div class="text-center mb-10">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Frequently Asked Questions
    </h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      Everything you need to know about private, browser-based PDF extraction.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {faqs.map((faq) => (
      <article class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#141a24] border border-slate-200/80 dark:border-[#212b3c] shadow-sm">
        <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white mb-2 leading-snug">
          {faq.question}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
          {faq.answer}
        </p>
      </article>
    ))}
  </div>

  <!-- JSON-LD FAQ Structured Data for Technical SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
